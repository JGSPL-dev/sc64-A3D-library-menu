diff --git a/.gitignore b/.gitignore
index 63aede6..4a04fdc 100644
--- a/.gitignore
+++ b/.gitignore
@@ -26,3 +26,7 @@
 
 # Ignore macOS filesystem cruft
 .DS_Store
+
+# Library build outputs
+/filesystem/*.font64
+/filesystem/*.sprite
diff --git a/Makefile b/Makefile
index cea8e99..50a00d9 100644
--- a/Makefile
+++ b/Makefile
@@ -52,6 +52,8 @@ SRCS = \
 	menu/disk_info.c \
 	menu/fonts.c \
 	menu/hdmi.c \
+	menu/library_config.c \
+	menu/labels_db.c \
 	menu/id3_parser.c \
 	menu/jpeg_decoder.c \
 	menu/menu.c \
@@ -67,6 +69,7 @@ SRCS = \
 	menu/ui_components/context_menu.c \
 	menu/ui_components/file_info.c \
 	menu/ui_components/file_list.c \
+	menu/ui_components/library_ui.c \
 	menu/ui_components/tabs.c \
 	menu/usb_comm.c \
 	menu/views/browser.c \
@@ -77,6 +80,10 @@ SRCS = \
 	menu/views/fault.c \
 	menu/views/file_info.c \
 	menu/views/history_favorites.c \
+	menu/views/library_settings.c \
+	menu/views/label_picker.c \
+	menu/views/library_configure.c \
+	menu/views/library_general.c \
 	menu/views/image_viewer.c \
 	menu/views/text_viewer.c \
 	menu/views/load_disk.c \
@@ -96,7 +103,27 @@ SRCS = \
 	utils/utf_converter.c \
 
 FONTS = \
-	Firple-Bold.ttf
+	Firple-Bold.ttf \
+	AnalogueOS-Sans.ttf \
+	AnalogueOS-Title.ttf \
+	VT323-Mono.ttf \
+	AnalogueOS-SansN.ttf \
+	AnalogueOS-TitleN.ttf \
+	VT323-MonoN.ttf
+
+IMAGES = \
+	lib-cart-sel.png \
+	lib-cart-small.png \
+	lib-disk-sel.png \
+	lib-disk-small.png \
+	lib-btn-a.png \
+	lib-btn-b.png \
+	lib-btn-right.png \
+	lib-btn-up.png \
+	lib-icon-library.png \
+	lib-icon-history.png \
+	lib-icon-favorites.png \
+	lib-icon-settings.png
 
 SOUNDS_WAV = \
 	cursorsound.wav \
@@ -123,6 +150,14 @@ $(MINIZ_OBJS): N64_CFLAGS+=-Wno-unused-function -fcompare-debug-second
 $(SPNG_OBJS): N64_CFLAGS+=-DSPNG_USE_MINIZ -fcompare-debug-second
 $(FILESYSTEM_DIR)/Firple-Bold.font64: MKFONT_FLAGS+=--compress 1 --outline 1 --size 15 --charset $(ASSETS_DIR)/fonts/charset.txt --ellipsis 2026,1
 $(FILESYSTEM_DIR)/%.wav64: AUDIOCONV_FLAGS=--wav-compress 1
+$(FILESYSTEM_DIR)/AnalogueOS-Sans.font64: MKFONT_FLAGS+=--compress 1 --monochrome --size 18 --charset $(ASSETS_DIR)/fonts/charset-ascii.txt --ellipsis 2E,3
+$(FILESYSTEM_DIR)/AnalogueOS-Title.font64: MKFONT_FLAGS+=--compress 1 --monochrome --size 30 --charset $(ASSETS_DIR)/fonts/charset-ascii.txt --ellipsis 2E,3
+$(FILESYSTEM_DIR)/VT323-Mono.font64: MKFONT_FLAGS+=--compress 1 --monochrome --size 20 --charset $(ASSETS_DIR)/fonts/charset-ascii.txt --ellipsis 2E,3
+# 75%-width, anti-aliased versions: undo the Analogue 3D's 4:3 -> 16:9 stretch so text keeps its real shape
+$(FILESYSTEM_DIR)/AnalogueOS-SansN.font64: MKFONT_FLAGS+=--compress 1 --size 18 --charset $(ASSETS_DIR)/fonts/charset-ascii.txt --ellipsis 2E,3
+$(FILESYSTEM_DIR)/AnalogueOS-TitleN.font64: MKFONT_FLAGS+=--compress 1 --size 30 --charset $(ASSETS_DIR)/fonts/charset-ascii.txt --ellipsis 2E,3
+$(FILESYSTEM_DIR)/VT323-MonoN.font64: MKFONT_FLAGS+=--compress 1 --size 20 --charset $(ASSETS_DIR)/fonts/charset-ascii.txt --ellipsis 2E,3
+$(FILESYSTEM_DIR)/lib-%.sprite: MKSPRITE_FLAGS=--format RGBA16
 
 $(@info $(shell mkdir -p ./$(FILESYSTEM_DIR) &> /dev/null))
 
