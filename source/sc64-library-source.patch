+
+// ---------------------------------------------------------------------------
+// Label cache
+
+typedef struct {
+    bool used;
+    uint32_t hash;
+    bool found;
+    surface_t surface;
+    uint32_t last_use;
+} label_slot_t;
+
+static label_slot_t label_cache[LABEL_CACHE_SIZE];
+static uint32_t label_clock = 0;
+
+static uint32_t hash_str (const char *s) {
+    uint32_t h = 2166136261u;
+    while (*s) {
+        h ^= (uint8_t)*s++;
+        h *= 16777619u;
+    }
+    return h;
+}
+
+surface_t *library_label_peek (const char *rom_path) {
+    if (!labels_db_available() || rom_path == NULL) {
+        return NULL;
+    }
+    uint32_t h = hash_str(rom_path);
+    for (int i = 0; i < LABEL_CACHE_SIZE; i++) {
+        if (label_cache[i].used && label_cache[i].hash == h) {
+            return label_cache[i].found ? &label_cache[i].surface : NULL;
+        }
+    }
+    return NULL;
+}
+
+surface_t *library_label_get (const char *rom_path, bool *pending) {
+    if (pending) {
+        *pending = false;
+    }
+    if (!labels_db_available() || rom_path == NULL) {
+        return NULL;
+    }
+    uint32_t h = hash_str(rom_path);
+    label_clock++;
+
+    for (int i = 0; i < LABEL_CACHE_SIZE; i++) {
+        if (label_cache[i].used && label_cache[i].hash == h) {
+            label_cache[i].last_use = label_clock;
+            return label_cache[i].found ? &label_cache[i].surface : NULL;
+        }
+    }
+
+    if (label_loads_this_frame >= 1) {
+        if (pending) {
+            *pending = true;
+        }
+        return NULL;
+    }
+    label_loads_this_frame++;
+
+    // Evict the least recently used slot.
+    int victim = 0;
+    for (int i = 0; i < LABEL_CACHE_SIZE; i++) {
+        if (!label_cache[i].used) {
+            victim = i;
+            break;
+        }
+        if (label_cache[i].last_use < label_cache[victim].last_use) {
+            victim = i;
+        }
+    }
+    label_slot_t *slot = &label_cache[victim];
+    if (slot->used && slot->found) {
+        rspq_wait();
+        surface_free(&slot->surface);
+    }
+    memset(slot, 0, sizeof(*slot));
+    slot->used = true;
+    slot->hash = h;
+    slot->last_use = label_clock;
+
+    uint32_t id;
+    if (labels_override_get(rom_path, &id) || labels_db_rom_id(rom_path, &id)) {
+        slot->found = labels_db_load(id, &slot->surface);
+    }
+    return slot->found ? &slot->surface : NULL;
+}
+
+void library_label_cache_clear (void) {
+    rspq_wait();
+    for (int i = 0; i < LABEL_CACHE_SIZE; i++) {
+        if (label_cache[i].used && label_cache[i].found) {
+            surface_free(&label_cache[i].surface);
+        }
+        memset(&label_cache[i], 0, sizeof(label_cache[i]));
+    }
+}
+
