+    rdpq_font_style(font, STL_GRAY, &((rdpq_fontstyle_t) { .color = RGBA32(0x8A, 0x8A, 0x90, 0xFF) }));
+    rdpq_font_style(font, STL_BLACK, &((rdpq_fontstyle_t) { .color = RGBA32(0x0A, 0x0A, 0x0B, 0xFF) }));
+    rdpq_font_style(font, STL_DIM, &((rdpq_fontstyle_t) { .color = RGBA32(0xC8, 0xC8, 0xCE, 0xFF) }));
+    rdpq_text_register_font(id, font);
+}
+
+
 void fonts_init (char *custom_font_path) {
     load_default_font(custom_font_path);
+    load_library_font("rom:/AnalogueOS-SansN.font64", FNT_LIB_SANS);
+    load_library_font("rom:/AnalogueOS-TitleN.font64", FNT_LIB_TITLE);
+    load_library_font("rom:/VT323-MonoN.font64", FNT_LIB_MONO);
 }
