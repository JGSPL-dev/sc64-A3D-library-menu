diff --git a/src/menu/labels_db.c b/src/menu/labels_db.c
new file mode 100644
index 0000000..75c1993
--- /dev/null
+++ b/src/menu/labels_db.c
@@ -0,0 +1,295 @@
+/**
+ * @file labels_db.c
+ * @brief Reader for the Analogue 3D cartridge label database (labels.db)
+ * @ingroup menu
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "labels_db.h"
+#include "ini_parser.h"
+#include "utils/fs.h"
+
+#define LABELS_KEYS_OFFSET      (0x100)
+#define LABELS_KEYS_SIZE        (0x4000)
+#define LABELS_DATA_OFFSET      (0x4100)
+#define LABELS_SLOT_SIZE        (25600)
+#define ROM_ID_BYTES            (8192)
+
+static char *db_path = NULL;
+static uint32_t *keys = NULL;
+static int key_count = 0;
+static uint32_t crc_table[256];
+static bool crc_table_ready = false;
+
+
+static void crc_table_init (void) {
+    for (uint32_t i = 0; i < 256; i++) {
+        uint32_t c = i;
+        for (int k = 0; k < 8; k++) {
+            c = (c & 1) ? (0xEDB88320u ^ (c >> 1)) : (c >> 1);
+        }
+        crc_table[i] = c;
+    }
+    crc_table_ready = true;
+}
+
+static uint32_t crc32_ieee (const uint8_t *data, size_t len) {
+    if (!crc_table_ready) {
+        crc_table_init();
+    }
+    uint32_t c = 0xFFFFFFFFu;
+    for (size_t i = 0; i < len; i++) {
+        c = crc_table[(c ^ data[i]) & 0xFF] ^ (c >> 8);
+    }
+    return c ^ 0xFFFFFFFFu;
+}
+
+static inline uint32_t read_le32 (const uint8_t *p) {
+    return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+bool labels_db_init (const char *path) {
+    labels_db_free();
+
+    FILE *f = fopen(path, "rb");
+    if (f == NULL) {
+        return false;
+    }
+
+    uint8_t header[0x40];
+    uint8_t *table = malloc(LABELS_KEYS_SIZE);
+    bool ok = (table != NULL)
+        && (fread(header, sizeof(header), 1, f) == 1)
+        && (memcmp(&header[1], "Analogue-Co", 11) == 0)
+        && (fseek(f, LABELS_KEYS_OFFSET, SEEK_SET) == 0)
+        && (fread(table, LABELS_KEYS_SIZE, 1, f) == 1);
+    fclose(f);
+
+    if (!ok) {
+        free(table);
+        return false;
+    }
+
+    int max_keys = LABELS_KEYS_SIZE / 4;
+    keys = malloc(max_keys * sizeof(uint32_t));
+    if (keys == NULL) {
+        free(table);
+        return false;
+    }
+
+    // Keys are sorted ascending; the table ends at 0xFFFFFFFF or the first key that is not larger.
+    uint32_t previous = 0;
+    for (int i = 0; i < max_keys; i++) {
+        uint32_t key = read_le32(&table[i * 4]);
+        if (key == 0xFFFFFFFFu || (i > 0 && key <= previous)) {
+            break;
+        }
+        keys[key_count++] = key;
+        previous = key;
+    }
+    free(table);
+
+    if (key_count == 0) {
+        labels_db_free();
+        return false;
+    }
+
+    db_path = strdup(path);
+    debugf("labels.db: %d labels\n", key_count);
+    return true;
+}
+
+void labels_db_free (void) {
+    free(keys);
+    keys = NULL;
+    key_count = 0;
+    free(db_path);
+    db_path = NULL;
+}
+
+bool labels_db_available (void) {
+    return key_count > 0;
+}
+
+bool labels_db_rom_id (const char *rom_path, uint32_t *id) {
+    FILE *f = fopen(rom_path, "rb");
+    if (f == NULL) {
+        return false;
+    }
+    uint8_t *buf = malloc(ROM_ID_BYTES);
+    if (buf == NULL) {
+        fclose(f);
+        return false;
+    }
+    size_t got = fread(buf, 1, ROM_ID_BYTES, f);
+    fclose(f);
+    if (got != ROM_ID_BYTES) {
+        free(buf);
+        return false;
+    }
+
+    // Normalise to Z64 (big-endian) byte order before hashing.
+    if (buf[0] == 0x37 && buf[1] == 0x80) {
+        for (size_t i = 0; i < ROM_ID_BYTES; i += 2) {
+            uint8_t t = buf[i]; buf[i] = buf[i + 1]; buf[i + 1] = t;
+        }
+    } else if (buf[0] == 0x40 && buf[1] == 0x12) {
+        for (size_t i = 0; i < ROM_ID_BYTES; i += 4) {
+            uint8_t a = buf[i], b = buf[i + 1];
+            buf[i] = buf[i + 3]; buf[i + 1] = buf[i + 2];
+            buf[i + 2] = b; buf[i + 3] = a;
+        }
+    }
+
+    *id = crc32_ieee(buf, ROM_ID_BYTES);
+    free(buf);
+    return true;
+}
+
+static int find_key (uint32_t id) {
+    int lo = 0, hi = key_count - 1;
+    while (lo <= hi) {
+        int mid = (lo + hi) / 2;
+        if (keys[mid] == id) {
+            return mid;
+        } else if (keys[mid] < id) {
+            lo = mid + 1;
+        } else {
+            hi = mid - 1;
+        }
+    }
+    return -1;
+}
+
+int labels_db_count (void) {
+    return key_count;
+}
+
+uint32_t labels_db_id_at (int index) {
+    return (index >= 0 && index < key_count) ? keys[index] : 0;
+}
+
+int labels_db_index_of (uint32_t id) {
+    return find_key(id);
+}
+
+bool labels_db_load (uint32_t id, surface_t *out) {
+    if (key_count == 0 || db_path == NULL) {
+        return false;
+    }
+    return labels_db_load_index(find_key(id), out);
+}
+
+bool labels_db_load_index (int index, surface_t *out) {
+    if (key_count == 0 || db_path == NULL || index < 0 || index >= key_count) {
+        return false;
+    }
+
+    size_t bytes = LABEL_WIDTH * LABEL_HEIGHT * 4;
+    uint8_t *bgra = malloc(bytes);
+    if (bgra == NULL) {
+        return false;
+    }
+
+    FILE *f = fopen(db_path, "rb");
+    bool ok = (f != NULL)
+        && (fseek(f, LABELS_DATA_OFFSET + (long)index * LABELS_SLOT_SIZE, SEEK_SET) == 0)
+        && (fread(bgra, bytes, 1, f) == 1);
+    if (f) {
+        fclose(f);
+    }
+    if (!ok) {
+        free(bgra);
+        return false;
+    }
+
+    *out = surface_alloc(FMT_RGBA16, LABEL_WIDTH, LABEL_HEIGHT);
+    if (out->buffer == NULL) {
+        free(bgra);
+        return false;
+    }
+
+    for (int y = 0; y < LABEL_HEIGHT; y++) {
+        uint16_t *row = (uint16_t *)((uint8_t *)out->buffer + y * out->stride);
+        const uint8_t *src = &bgra[y * LABEL_WIDTH * 4];
+        for (int x = 0; x < LABEL_WIDTH; x++) {
+            const uint8_t *p = &src[x * 4];
+            row[x] = color_to_packed16(RGBA32(p[2], p[1], p[0], 0xFF));
+        }
+    }
+
+    free(bgra);
+    return true;
+}
+
+
+// ---------------------------------------------------------------------------
+// Per-game label choices, stored in /menu/label_overrides.ini as
+//   [labels]
+//   <hash of the ROM path> = <cartridge ID>
+// A hash is used as the key because ROM file names often contain [ ] and =.
+
+#define OVERRIDES_SECTION "labels"
+
+static char *overrides_path = NULL;
+static ini_t *overrides = NULL;
+
+static void override_key (const char *rom_path, char *key) {
+    const char *p = strip_fs_prefix((char *)rom_path);
+    uint32_t h = 2166136261u;
+    while (*p) {
+        h ^= (uint8_t)*p++;
+        h *= 16777619u;
+    }
+    sprintf(key, "%08lx", (unsigned long)h);
+}
+
+void labels_overrides_init (const char *ini_path) {
+    free(overrides_path);
+    overrides_path = strdup(ini_path);
+    if (overrides) {
+        ini_free(overrides);
+    }
+    overrides = ini_try_load(ini_path);
+    if (!overrides) {
+        overrides = ini_create();
+    }
+}
+
+bool labels_override_get (const char *rom_path, uint32_t *id) {
+    if (!overrides) {
+        return false;
+    }
+    char key[12];
+    override_key(rom_path, key);
+    const char *v = ini_get_string(overrides, OVERRIDES_SECTION, key, NULL);
+    if (!v || !v[0]) {
+        return false;
+    }
+    *id = (uint32_t)strtoul(v, NULL, 16);
+    return true;
+}
+
+void labels_override_set (const char *rom_path, uint32_t id) {
+    if (!overrides || !overrides_path) {
+        return;
+    }
+    char key[12], value[12];
+    override_key(rom_path, key);
+    sprintf(value, "%08lx", (unsigned long)id);
+    ini_set_string(overrides, OVERRIDES_SECTION, key, value);
+    ini_save(overrides, overrides_path);
+}
+
+void labels_override_clear (const char *rom_path) {
+    if (!overrides || !overrides_path) {
+        return;
+    }
+    char key[12];
+    override_key(rom_path, key);
+    ini_delete_key(overrides, OVERRIDES_SECTION, key);
+    ini_save(overrides, overrides_path);
+}
diff --git a/src/menu/labels_db.h b/src/menu/labels_db.h
new file mode 100644
index 0000000..9eeadf6
--- /dev/null
+++ b/src/menu/labels_db.h
@@ -0,0 +1,63 @@
+/**
+ * @file labels_db.h
+ * @brief Reader for the Analogue 3D cartridge label database (labels.db)
+ * @ingroup menu
+ *
+ * The file holds a sorted table of 32-bit cartridge IDs (little-endian, at 0x100)
+ * and one 74x86 BGRA image per ID in 25600-byte slots starting at 0x4100.
+ * A cartridge ID is the CRC32 (IEEE) of the first 8 KiB of the ROM in Z64 byte order.
+ */
+
+#ifndef LABELS_DB_H__
+#define LABELS_DB_H__
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <libdragon.h>
+
+#define LABEL_WIDTH     (74)
+#define LABEL_HEIGHT    (86)
+
+/** @brief Open the label database. Returns false if the file is missing or invalid. */
+bool labels_db_init (const char *path);
+
+/** @brief Release the label database. */
+void labels_db_free (void);
+
+/** @brief True when a label database is loaded. */
+bool labels_db_available (void);
+
+/** @brief Compute the Analogue 3D cartridge ID of a ROM file. Returns false on read error. */
+bool labels_db_rom_id (const char *rom_path, uint32_t *id);
+
+/**
+ * @brief Load the label for a cartridge ID into a newly allocated RGBA16 surface.
+ * @return true on success (caller frees with surface_free), false when there is no label.
+ */
+bool labels_db_load (uint32_t id, surface_t *out);
+
+/** @brief Number of labels in the database. */
+int labels_db_count (void);
+
+/** @brief Cartridge ID of the label at @p index (0 .. count-1). */
+uint32_t labels_db_id_at (int index);
+
+/** @brief Index of a cartridge ID in the database, or -1. */
+int labels_db_index_of (uint32_t id);
+
+/** @brief Load the label at @p index into a newly allocated RGBA16 surface. */
+bool labels_db_load_index (int index, surface_t *out);
+
+/** @brief Load the per-game label choices from @p ini_path. */
+void labels_overrides_init (const char *ini_path);
+
+/** @brief Label chosen by the player for this ROM, if any. */
+bool labels_override_get (const char *rom_path, uint32_t *id);
+
+/** @brief Remember a chosen label for this ROM. */
+void labels_override_set (const char *rom_path, uint32_t id);
+
+/** @brief Forget the chosen label for this ROM. */
+void labels_override_clear (const char *rom_path);
+
+#endif /* LABELS_DB_H__ */
