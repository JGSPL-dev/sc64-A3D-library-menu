+// ---------------------------------------------------------------------------
+// Configure / settings pages: categories on the left, rows on the right (3DOS layout)
+
+void library_ui_config_page (const char *title,
+                             const char *const *categories, int category_count, int category_selected, bool rows_focused,
+                             const lib_row_t *rows, int row_count, int row_selected) {
+    // Left: categories as pills.
+    float y = DY(200);
+    for (int i = 0; i < category_count; i++) {
+        float x = DX(70);
+        if (i == category_selected) {
+            float w = text_width(FNT_LIB_SANS, STL_DEFAULT, categories[i]);
+            color_t c = rows_focused ? RGBA32(0x5C, 0x5C, 0x62, 0xFF) : COLOR_WHITE;
+            rounded(x - 10, y - 17, x + (w > DX(260) ? w : DX(260)) + 10, y + 6, 9, c);
+            text(FNT_LIB_SANS, rows_focused ? STL_DEFAULT : STL_BLACK, x, y, 0, ALIGN_LEFT, categories[i]);
+        } else {
+            text(FNT_LIB_SANS, STL_DEFAULT, x, y, 0, ALIGN_LEFT, categories[i]);
+        }
+        y += DY(48);
+    }
+
+    // Title.
+    text(FNT_LIB_SANS, STL_DEFAULT, DX(LIB_COLUMN_X), DY(95), DX(1280 - LIB_COLUMN_X - 64), ALIGN_LEFT, title);
+
+    // Rows; scroll so the selection stays visible.
+    const float top = DY(165), bottom = DY(630), line = DY(40), gap = DY(22);
+    float total = 0, sel_y = 0;
+    for (int i = 0; i < row_count; i++) {
+        if (rows[i].section) total += gap + line * 0.8f;
+        if (i == row_selected) sel_y = total;
+        total += line;
+    }
+    float scroll = 0;
+    float view = bottom - top;
+    if (sel_y + line * 2 > view) {
+        scroll = sel_y + line * 2 - view;
+    }
+    if (scroll > total - view) scroll = total - view;
+    if (scroll < 0) scroll = 0;
+    scroll = floorf(scroll + 0.5f);
+    rdpq_set_scissor(0, (int)top - 4, 640, (int)bottom);
+
+    float x0 = DX(LIB_COLUMN_X), x1 = DX(1280 - 64);
+    y = top - scroll;
+    for (int i = 0; i < row_count; i++) {
+        const lib_row_t *r = &rows[i];
+        if (r->section) {
+            if (i > 0) y += gap;
+            if (y > top - line && y < bottom) {
+                text(FNT_LIB_MONO, STL_DIM, x0, y + 12, 0, ALIGN_LEFT, r->section);
+            }
+            y += line * 0.8f;
+        }
+        if (y > top - line && y < bottom) {
+            float base = y + 16;
+            bool sel = rows_focused && i == row_selected;
+            if (sel) {
+                rounded(x0 - 10, y - 2, x1 + 6, y + line - 4, 9, COLOR_WHITE);
+            }
+            int st = sel ? STL_BLACK : (r->disabled ? STL_GRAY : STL_DEFAULT);
+            if (sel) { marquee(r->mono ? FNT_LIB_MONO : FNT_LIB_SANS, st, x0, base, DX(380), y, y + line, r->label); rdpq_set_scissor(0, (int)top - 4, 640, (int)bottom); }
+            else text(r->mono ? FNT_LIB_MONO : FNT_LIB_SANS, st, x0, base, DX(380), ALIGN_LEFT, r->label);
+
+            if (r->kind == LIB_ROW_TOGGLE) {
+                // Switch: pill outline, knob left (off) or filled with knob right (on).
+                float sx1 = x1 - 4, sx0 = sx1 - 30, sy0 = y + 1, sy1 = y + 19;
+                color_t fg = sel ? RGBA32(0x0A, 0x0A, 0x0B, 0xFF) : COLOR_WHITE;
+                color_t bg = sel ? COLOR_WHITE : COLOR_BG;
+                rounded(sx0, sy0, sx1, sy1, 9, fg);
+                if (!r->on) {
+                    rounded(sx0 + 2, sy0 + 2, sx1 - 2, sy1 - 2, 7, bg);
+                    rounded(sx0 + 4, sy0 + 4, sx0 + 16, sy1 - 4, 5, fg);
+                } else {
+                    rounded(sx1 - 16, sy0 + 4, sx1 - 4, sy1 - 4, 5, bg);
+                }
+                text(FNT_LIB_MONO, st, sx0 - 50, base, 44, ALIGN_RIGHT, r->on ? "ON" : "OFF");
+            } else if (r->value) {
+                float vw = DX(1280 - 64) - DX(LIB_COLUMN_X) - DX(400);
+                if (r->kind == LIB_ROW_CHOICE) {
+                    char v[96];
+                    snprintf(v, sizeof(v), "< %s >", r->value);
+                    text(r->mono ? FNT_LIB_MONO : FNT_LIB_SANS, st, x1 - vw - 4, base, vw, ALIGN_RIGHT, v);
+                } else if (sel && text_width(r->mono ? FNT_LIB_MONO : FNT_LIB_SANS, st, r->value) > vw) {
+                    marquee(r->mono ? FNT_LIB_MONO : FNT_LIB_SANS, st, x1 - vw - 4, base, vw, y, y + line, r->value);
+                    rdpq_set_scissor(0, (int)top - 4, 640, (int)bottom);
+                } else {
+                    text(r->mono ? FNT_LIB_MONO : FNT_LIB_SANS, st, x1 - vw - 4, base, vw, ALIGN_RIGHT, r->value);
+                }
+            }
+        }
+        y += line;
+    }
+    rdpq_set_scissor(0, 0, 640, 480);
+
+    // Scroll hints when rows are hidden above or below.
+    if (scroll > 0) text(FNT_LIB_MONO, STL_GRAY, x1 - 60, top - 6, 60, ALIGN_RIGHT, "MORE");
+    if (total - scroll > view + 1) text(FNT_LIB_MONO, STL_GRAY, x1 - 60, bottom + 12, 60, ALIGN_RIGHT, "MORE");
+}
