+/**
+ * @file library_ui.h
+ * @brief 3DOS-style Library drawing helpers (tabs, cartridge rows, info grid, footer)
+ * @ingroup ui_components
+ *
+ * Layout is authored in "design" units for a 1280x720 16:9 picture and converted
+ * to the 640x480 framebuffer, which the TV/Analogue 3D stretches back to 16:9.
+ */
+
+#ifndef LIBRARY_UI_H__
+#define LIBRARY_UI_H__
+
+#include <libdragon.h>
+#include "../menu_state.h"
+
+/** @brief Convert design X (1280-wide, 16:9) to framebuffer X. */
+#define DX(v)   ((float)(v) * 0.5f)
+/** @brief Convert design Y (720-high) to framebuffer Y. */
+#define DY(v)   ((float)(v) * (2.0f / 3.0f))
+
+/** @brief Column where the selected cartridge and the info values sit (design units). */
+#define LIB_COLUMN_X    (466)
+
+typedef enum {
+    LIB_TAB_LIBRARY = 0,
+    LIB_TAB_HISTORY,
+    LIB_TAB_FAVORITES,
+    LIB_TAB_SETTINGS,
+    LIB_TAB_COUNT,
+} lib_tab_t;
+
+typedef enum {
+    LIB_TILE_FOLDER,        /**< Grey cartridge with lettering */
+    LIB_TILE_DISK_FOLDER,   /**< 64DD disk with lettering */
+    LIB_TILE_ROM,           /**< Cartridge with label art (or blank grey) */
+    LIB_TILE_DISK,          /**< 64DD disk image */
+    LIB_TILE_OTHER,         /**< Any other file: blank cartridge */
+    LIB_TILE_EMPTY,         /**< Empty favourite slot */
+} lib_tile_kind_t;
+
+typedef enum {
+    LIB_BTN_A,
+    LIB_BTN_B,
+    LIB_BTN_C_RIGHT,
+    LIB_BTN_C_UP,
+    LIB_BTN_Z,
+    LIB_BTN_DPAD,
+    LIB_BTN_LR,         /**< L/R shoulder badge */
+    LIB_BTN_C_LR,       /**< C-left / C-right pair */
+} lib_button_t;
+
+typedef struct {
+    lib_tile_kind_t kind;
+    const char *caption;    /**< Name shown under unselected tiles */
+    const char *code;       /**< Lettering on folder labels ("US") */
+    surface_t *label;       /**< Label art, or NULL for a blank label */
+    bool label_pending;     /**< Label art is still loading */
+} lib_tile_t;
+
+/** @brief Load sprites. Safe to call more than once. */
+void library_ui_init (void);
+
+/** @brief Start a frame: attach, clear to black, reset per-frame budgets. */
+void library_ui_begin (surface_t *display);
+
+/** @brief Finish a frame: detach and show. */
+void library_ui_end (void);
+
+/** @brief Tab bar (active tab shows its icon and name) and the L|R badge. */
+void library_ui_header (lib_tab_t tab);
+
+/** @brief Controller dots, button hints (from the column) and the clock. */
+void library_ui_footer (menu_t *menu, int hint_count, const lib_button_t *buttons, const char *const *texts);
+
+/** @brief Cartridge row. The selected tile sits at the info column; others flow left and right. */
+void library_ui_row (const lib_tile_t *tiles, int count, int selected, bool dimmed, char marker);
+
+/** @brief A-Z jump bar. @p available marks letters that have entries (28 slots: '#', A-Z, '?'). */
+void library_ui_alpha_bar (int current_slot, const bool *available);
+
+/** @brief Large title under the row. */
+void library_ui_title (const char *title);
+
+/** @brief Label/value grid under the title. Rows with a NULL label add a group gap. Chip rows draw values as chips. */
+void library_ui_info (const char *const *labels, const char *const *values, const bool *chips, int count);
+
+/** @brief Centered message under the row (empty folders etc.). */
+void library_ui_message (const char *text);
+
+/** @brief Left menu + right rows used by the Settings tab. */
+void library_ui_settings_list (const char *heading, const char *const *items, int count, int selected);
+
+typedef enum {
+    LIB_ROW_INFO,       /**< Label and value, nothing to change */
+    LIB_ROW_CHOICE,     /**< Left/right cycles the value */
+    LIB_ROW_TOGGLE,     /**< A or left/right flips the switch */
+    LIB_ROW_ACTION,     /**< A opens something */
+} lib_row_kind_t;
+
+typedef struct {
+    const char *section;    /**< Sub-header drawn above this row, or NULL */
+    const char *label;
+    const char *value;
+    lib_row_kind_t kind;
+    bool on;
+    bool disabled;
+    bool mono;              /**< Draw in the monospaced font (ROM info values) */
+} lib_row_t;
+
+/** @brief 3DOS configure layout: categories on the left, rows on the right. */
+void library_ui_config_page (const char *title,
+                             const char *const *categories, int category_count, int category_selected, bool rows_focused,
+                             const lib_row_t *rows, int row_count, int row_selected);
+
+/** @brief Draw text in a Library font (trimmed to @p width with "..." when needed). */
+void library_ui_text (int font, int style, float x, float baseline, float width, rdpq_align_t align, const char *str);
+
+/** @brief Copy @p in to @p out with libdragon text escapes doubled and non-ASCII replaced. Returns @p out. */
+const char *library_ui_safe (const char *in, char *out, size_t out_len);
+
+/** @brief Map a list slot ('#', A-Z, '?') from a title. */
+int library_alpha_slot (const char *title);
+
+/** @brief Character shown for an alphabet slot. */
+char library_alpha_char (int slot);
+
+/** @brief Turn a ROM file name into a display title ("Yoshi's Story (E) [!].z64" -> "Yoshi's Story"). */
+void library_clean_title (const char *name, char *out, size_t out_len);
+
+/** @brief Get label art for a ROM path, loading at most one new label per frame. */
+surface_t *library_label_get (const char *rom_path, bool *pending);
+
+/** @brief Cached label art for a ROM path, never loading from the SD card (NULL if not cached). */
+surface_t *library_label_peek (const char *rom_path);
+
+/** @brief 3DOS-style progress screen: message, thin bar, percentage. Draws into the attached display. */
+void library_ui_loader (float progress, const char *msg);
+
+/** @brief Game loading screen: selected cart with its label, title, bar and percentage. */
+void library_ui_cart_loader (float progress, const char *title, surface_t *label, bool disk);
+
+/** @brief Dim the screen and draw a 3DOS-style rounded panel. */
+void library_ui_panel (int x0, int y0, int x1, int y1);
+
+/** @brief Centred option list in a panel; the selected row is a white pill. */
+void library_ui_popup (const char *const *items, int count, int selected);
+
+/** @brief Drop all cached labels. */
+void library_label_cache_clear (void);
+
+#endif /* LIBRARY_UI_H__ */
