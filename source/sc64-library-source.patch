+// ---------------------------------------------------------------------------
+// Alphabet bar
+
+char library_alpha_char (int slot) {
+    if (slot <= 0) return '#';
+    if (slot >= 27) return '?';
+    return 'A' + (slot - 1);
+}
+
+int library_alpha_slot (const char *title) {
+    unsigned char c = (unsigned char)(title ? title[0] : 0);
+    if (isdigit(c)) return 0;
+    if (isalpha(c)) return toupper(c) - 'A' + 1;
+    return 27;
+}
+
+void library_ui_alpha_bar (int current_slot, const bool *available) {
+    float step = DX(34);
+    float total = step * 28;
+    float x = (640 - total) / 2;
+    float base = DY(108);
+    for (int i = 0; i < 28; i++) {
+        char s[2] = { library_alpha_char(i), 0 };
+        if (i == current_slot) {
+            fill(x + 1, base - 15, x + step - 1, base + 4, COLOR_WHITE);
+            text(FNT_LIB_MONO, STL_BLACK, x, base, step, ALIGN_CENTER, s);
+        } else {
+            text(FNT_LIB_MONO, (available && !available[i]) ? STL_GRAY : STL_DEFAULT, x, base, step, ALIGN_CENTER, s);
+        }
+        x += step;
+    }
+}
