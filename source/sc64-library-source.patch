+// ---------------------------------------------------------------------------
+// Loading screens (draw into an already attached display)
+
+static void progress_bar (int x0, int x1, int y, float progress) {
+    if (progress < 0) progress = 0;
+    if (progress > 1) progress = 1;
+    rounded(x0, y, x1, y + 6, 3, RGBA32(0x3A, 0x3A, 0x40, 0xFF));
+    int fx = x0 + (int)((x1 - x0) * progress + 0.5f);
+    if (fx < x0 + 6) fx = x0 + 6;
+    rounded(x0, y, fx, y + 6, 3, COLOR_WHITE);
+}
+
+void library_ui_loader (float progress, const char *msg) {
+    library_ui_init();
+    fill(0, 0, 640, 480, COLOR_BG);
+    const int cx = 320;
+    if (msg) {
+        text(FNT_LIB_SANS, STL_DEFAULT, cx - 200, DY(330), 400, ALIGN_CENTER, msg);
+    }
+    progress_bar(cx - 140, cx + 140, (int)DY(360), progress);
+    char pct[8];
+    snprintf(pct, sizeof(pct), "%d%%", (int)(progress * 100.0f + 0.5f));
+    text(FNT_LIB_MONO, STL_DIM, cx - 60, DY(410), 120, ALIGN_CENTER, pct);
+}
+
+void library_ui_cart_loader (float progress, const char *title, surface_t *label, bool disk) {
+    library_ui_init();
+    fill(0, 0, 640, 480, COLOR_BG);
+    const int cx = 320;
+
+    // Selected-cart frame, as in the Library row.
+    int fw = (int)DX(SEL_W), fh = (int)DY(SEL_H);
+    int x0 = cx - fw / 2, y0 = (int)DY(170);
+    int x1 = x0 + fw, y1 = y0 + fh;
+    rounded(x0, y0, x1, y1, 8, COLOR_PURE_WHITE);
+    rounded(x0 + 3, y0 + 4, x1 - 3, y1 - 4, 6, COLOR_BG);
+    rounded(x0 + 5, y0 + 6, x1 - 5, y1 - 6, 5, COLOR_PURE_WHITE);
+
+    lib_tile_t t = { .kind = disk ? LIB_TILE_DISK : LIB_TILE_ROM, .label = label };
+    int mx = (x0 + x1) / 2, my = (y0 + y1) / 2;
+    if (disk) {
+        int x = mx - DISK_SEL_W / 2, y = my - DISK_SEL_H / 2;
+        copy_sprite(spr_disk_sel, x, y);
+        draw_label(&t, x + DISK_SEL_WIN_X, y + DISK_SEL_WIN_Y, DISK_SEL_WIN_W, DISK_SEL_WIN_H, true);
+    } else {
+        int x = mx - CART_SEL_W / 2, y = my - CART_SEL_H / 2;
+        copy_sprite(spr_cart_sel, x, y);
+        draw_label(&t, x + CART_SEL_WIN_X, y + CART_SEL_WIN_Y, CART_SEL_WIN_W, CART_SEL_WIN_H, true);
+    }
+
+    if (title) {
+        text(FNT_LIB_TITLE, STL_DEFAULT, cx - 280, DY(470), 560, ALIGN_CENTER, title);
+    }
+    const int bx0 = cx - 110, bx1 = cx + 110;
+    progress_bar(bx0, bx1, (int)DY(510), progress);
+    text(FNT_LIB_MONO, STL_DIM, bx0, DY(560), 0, ALIGN_LEFT, "LOADING");
+    char pct[8];
+    snprintf(pct, sizeof(pct), "%d%%", (int)(progress * 100.0f + 0.5f));
+    text(FNT_LIB_MONO, STL_DIM, bx1 - 80, DY(560), 80, ALIGN_RIGHT, pct);
+}
+
+
+// ---------------------------------------------------------------------------
+// Pop-ups: dialogs, message boxes and option menus (draw over the current screen)
+
+void library_ui_panel (int x0, int y0, int x1, int y1) {
+    library_ui_init();
+    dim_area(0, 0, 640, 480);
+    rounded(x0, y0, x1, y1, 10, RGBA32(0x3A, 0x3A, 0x40, 0xFF));
+    rounded(x0 + 2, y0 + 2, x1 - 2, y1 - 2, 9, RGBA32(0x1C, 0x1C, 0x1F, 0xFF));
+}
+
+void library_ui_popup (const char *const *items, int count, int selected) {
+    const float pitch = DY(42);
+    float w = 0;
+    for (int i = 0; i < count; i++) {
+        float tw = text_width(FNT_LIB_SANS, STL_DEFAULT, items[i]);
+        if (tw > w) w = tw;
+    }
+    if (w > 440) w = 440;
+    int pw = (int)w + 56, ph = (int)(pitch * count) + 28;
+    int x0 = 320 - pw / 2, y0 = 240 - ph / 2;
+    library_ui_panel(x0, y0, x0 + pw, y0 + ph);
+
+    float y = y0 + 14;
+    for (int i = 0; i < count; i++) {
+        bool sel = (i == selected);
+        if (sel) {
+            rounded(x0 + 10, y, x0 + pw - 10, y + pitch - 2, 9, COLOR_WHITE);
+        }
+        text(FNT_LIB_SANS, sel ? STL_BLACK : STL_DEFAULT, x0 + 28, y + pitch / 2 + 6, pw - 56, ALIGN_LEFT, items[i]);
+        y += pitch;
+    }
+}
