+// ---------------------------------------------------------------------------
+// Titles
+
+void library_clean_title (const char *name, char *out, size_t out_len) {
+    if (!out_len) {
+        return;
+    }
+    size_t n = 0;
+    const char *dot = strrchr(name, '.');
+    for (const char *p = name; *p && n < out_len - 1; p++) {
+        if (dot && p == dot) {
+            break;
+        }
+        if ((*p == '(' || *p == '[') && n > 0) {
+            break;
+        }
+        out[n++] = *p;
+    }
+    while (n > 0 && (out[n - 1] == ' ' || out[n - 1] == '_' || out[n - 1] == '-')) {
+        n--;
+    }
+    out[n] = 0;
+    for (size_t i = 0; i < n; i++) {
+        if (out[i] == '_') out[i] = ' ';
+    }
+}
