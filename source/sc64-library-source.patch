+void library_ui_info (const char *const *labels, const char *const *values, const bool *chips, int count) {
+    float y = DY(448);
+    const float row = DY(25);
+    bool gap_pending = false, any = false;
+    for (int i = 0; i < count; i++) {
+        if (labels[i] == NULL) {
+            gap_pending = any;
+            continue;
+        }
+        if (values[i] && values[i][0] == 0) {
+            continue;   // unknown: leave the row out
+        }
+        if (gap_pending) {
+            y += DY(12);
+            gap_pending = false;
+        }
+        any = true;
+        text(FNT_LIB_MONO, STL_DEFAULT, DX(64), y, DX(LIB_COLUMN_X - 80), ALIGN_LEFT, labels[i]);
+        const char *v = (values[i] && values[i][0]) ? values[i] : "-";
+        if (chips && chips[i] && strcmp(v, "-") != 0) {
+            float cx = DX(LIB_COLUMN_X);
+            fill(cx - 3, y - 12, cx + text_width(FNT_LIB_MONO, STL_BLACK, v) + 3, y + 3, COLOR_CHIP);
+            text(FNT_LIB_MONO, STL_BLACK, cx, y, 0, ALIGN_LEFT, v);
+        } else {
+            text(FNT_LIB_MONO, STL_DEFAULT, DX(LIB_COLUMN_X), y, DX(1280 - LIB_COLUMN_X - 40), ALIGN_LEFT, v);
+        }
+        y += row;
+    }
+}
