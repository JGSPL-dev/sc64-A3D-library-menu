index 0000000..070c890
--- /dev/null
+++ b/src/menu/ui_components/library_ui.c
@@ -0,0 +1,882 @@
+/**
+ * @file library_ui.c
+ * @brief 3DOS-style Library drawing helpers
+ * @ingroup ui_components
+ */
+
+#include <ctype.h>
+#include <math.h>
+#include <stdio.h>
+#include <string.h>
+#include <time.h>
+
+#include "library_ui.h"
+#include "../fonts.h"
+#include "../labels_db.h"
+#include "lib_sprites.h"
+
+#define COLOR_BG            RGBA32(0x0A, 0x0A, 0x0B, 0xFF)
+#define COLOR_WHITE         RGBA32(0xF2, 0xF2, 0xF2, 0xFF)
+#define COLOR_PURE_WHITE    RGBA32(0xFF, 0xFF, 0xFF, 0xFF)
+#define COLOR_TILE          RGBA32(0x23, 0x23, 0x26, 0xFF)
+#define COLOR_LABEL_BLANK   RGBA32(0x8F, 0x8F, 0x95, 0xFF)
+#define COLOR_LABEL_LOADING RGBA32(0x5E, 0x5E, 0x66, 0xFF)
+#define COLOR_CHIP          RGBA32(0xE6, 0xE6, 0xEA, 0xFF)
+#define COLOR_BADGE         RGBA32(0xD6, 0xE2, 0xF5, 0xFF)
+#define COLOR_DOT_OFF       RGBA32(0x5C, 0x5C, 0x62, 0xFF)
+#define COLOR_ICON_OFF      RGBA32(0xA8, 0xA8, 0xAE, 0xFF)
+
+// Row geometry (design units)
+#define ROW_TOP             (140)
+#define SEL_W               (256)
+#define SEL_H               (174)
+#define SMALL_W             (SEL_W)   // 3DOS: every tile the same size; selection only turns it white
+#define SMALL_H             (SEL_H)
+#define ROW_GAP             (24)
+
+#define LABEL_CACHE_SIZE    (14)
+
+static bool initialized = false;
+static sprite_t *spr_cart_sel, *spr_cart_small;
+static sprite_t *spr_disk_sel, *spr_disk_small;
+static sprite_t *spr_btn[4];
+static sprite_t *spr_icon[LIB_TAB_COUNT];
+static int label_loads_this_frame;
+
+static const char *tab_names[LIB_TAB_COUNT] = { "Library", "History", "Favorites", "Settings" };
+
+
+// ---------------------------------------------------------------------------
+// Primitives
+
+static void fill (float x0, float y0, float x1, float y1, color_t color) {
+    rdpq_set_mode_fill(color);
+    rdpq_fill_rectangle(x0, y0, x1, y1);
+}
+
+// Rounded box in framebuffer coordinates; corners are elliptical to stay round after the 16:9 stretch.
+static void rounded (float x0, float y0, float x1, float y1, float ry, color_t color) {
+    float rx = ry * 0.75f;
+    int r = (int)ry;
+    rdpq_set_mode_fill(color);
+    rdpq_fill_rectangle(x0, y0 + r, x1, y1 - r);
+    for (int i = 0; i < r; i++) {
+        float dy = (float)r - (float)i - 0.5f;
+        float t = 1.0f - (dy * dy) / (ry * ry);
+        float dx = rx - rx * sqrtf(t > 0 ? t : 0);
+        rdpq_fill_rectangle(x0 + dx, y0 + i, x1 - dx, y0 + i + 1);
+        rdpq_fill_rectangle(x0 + dx, y1 - i - 1, x1 - dx, y1 - i);
+    }
+}
+
+static void blit_sprite (sprite_t *s, float x, float y, float sx, float sy, bool smooth) {
+    x = floorf(x + 0.5f);
+    y = floorf(y + 0.5f);
+    rdpq_set_mode_standard();
+    rdpq_mode_alphacompare(1);
+    rdpq_mode_filter(smooth ? FILTER_BILINEAR : FILTER_POINT);
+    rdpq_sprite_blit(s, x, y, &(rdpq_blitparms_t) { .scale_x = sx, .scale_y = sy, .filtering = smooth });
+}
+
+static void blit_surface (surface_t *s, float x, float y, float sx, float sy) {
+    x = floorf(x + 0.5f);
+    y = floorf(y + 0.5f);
+    rdpq_set_mode_standard();
+    rdpq_mode_filter(FILTER_BILINEAR);
+    rdpq_tex_blit(s, x, y, &(rdpq_blitparms_t) { .scale_x = sx, .scale_y = sy, .filtering = true });
+}
+
+// Make any string safe to hand to rdpq_text: '$' and '^' start font/style escapes in libdragon
+// (a stray one asserts), and the Library fonts only cover printable ASCII.
+const char *library_ui_safe (const char *in, char *out, size_t out_len) {
+    size_t n = 0;
+    if (in == NULL) in = "";
+    for (const unsigned char *p = (const unsigned char *)in; *p && n + 2 < out_len; p++) {
+        unsigned char c = *p;
+        if (c == '$' || c == '^') {
+            out[n++] = c;
+            out[n++] = c;
+        } else if (c < 0x20 || c > 0x7E) {
+            if (n == 0 || out[n - 1] != ' ') out[n++] = ' ';
+        } else {
+            out[n++] = c;
+        }
+    }
+    out[n] = 0;
+    return out;
+}
+
+static float text_width_raw (int font, int style, const char *str) {
+    // Measure with no width limit, drawn off-screen (clipped, nothing visible).
+    rdpq_textmetrics_t m = rdpq_text_print(&(rdpq_textparms_t) { .style_id = style }, font, -2000, -2000, str);
+    return m.advance_x;
+}
+
+static float text_width (int font, int style, const char *str) {
+    char safe[256];
+    return text_width_raw(font, style, library_ui_safe(str, safe, sizeof(safe)));
+}
+
+// Draw text inside a box. Long text is trimmed with "..." by the menu itself;
+// libdragon's own ellipsis wrapping is never used (it can assert on short strings in tight boxes).
+static void text (int font, int style, float x, float baseline, float width, rdpq_align_t align, const char *raw) {
+    if (raw == NULL || raw[0] == 0) {
+        return;
+    }
+    char clean[128];
+    // Drop escape characters entirely for trimming purposes: trimming could split a doubled "$$".
+    size_t cn = 0;
+    for (const unsigned char *p = (const unsigned char *)raw; *p && cn < sizeof(clean) - 1; p++) {
+        unsigned char c = *p;
+        if (c < 0x20 || c > 0x7E || c == '$' || c == '^') c = (c == '$') ? 'S' : ' ';
+        clean[cn++] = c;
+    }
+    clean[cn] = 0;
+    const char *str = clean;
+    const char *out = str;
+    char trimmed[128];
+
+    if (width > 0 && text_width_raw(font, style, str) > width) {
+        size_t len = strlen(str);
+        if (len > sizeof(trimmed) - 4) {
+            len = sizeof(trimmed) - 4;
+        }
+        // Shorten until "text..." fits; give up at zero characters (draw nothing).
+        out = NULL;
+        while (len > 0) {
+            len--;
+            while (len > 0 && str[len - 1] == ' ') {
+                len--;
+            }
+            memcpy(trimmed, str, len);
+            strcpy(trimmed + len, "...");
+            if (len == 0 || text_width_raw(font, style, trimmed) <= width) {
+                out = len > 0 ? trimmed : NULL;
+                break;
+            }
+        }
+        if (out == NULL) {
+            return;
+        }
+    }
+
+    rdpq_textparms_t parms = {
+        .style_id = style,
+        .width = width,
+        .align = align,
+        .wrap = WRAP_NONE,
+    };
+    x = floorf(x + 0.5f);
+    baseline = floorf(baseline + 0.5f);
+    rdpq_text_print(&parms, font, x, baseline, out);
+}
+
+// Text that does not fit scrolls sideways inside its box (pause, scroll, pause, jump back).
+// Short text is drawn normally.
+static void marquee (int font, int style, float x, float baseline, float width, float top, float bottom, const char *raw) {
+    if (raw == NULL || raw[0] == 0) {
+        return;
+    }
+    char safe[256];
+    const char *str = library_ui_safe(raw, safe, sizeof(safe));
+    float w = text_width_raw(font, style, str);
+    if (w <= width) {
+        text(font, style, x, baseline, width, ALIGN_LEFT, raw);
+        return;
+    }
+    const float speed = 40.0f;          // pixels per second
+    const float pause = 1.5f;           // seconds at each end
+    float travel = w - width + 8;
+    float cycle = pause * 2 + travel / speed;
+    float t = fmodf((float)get_ticks_ms() / 1000.0f, cycle);
+    float offset = 0;
+    if (t > pause) offset = (t - pause) * speed;
+    if (offset > travel) offset = travel;
+
+    int sx0 = (int)floorf(x + 0.5f), sx1 = (int)floorf(x + width + 0.5f);
+    rdpq_set_scissor(sx0, (int)top, sx1, (int)bottom);
+    rdpq_textparms_t parms = { .style_id = style, .wrap = WRAP_NONE };
+    rdpq_text_print(&parms, font, floorf(x - offset + 0.5f), floorf(baseline + 0.5f), str);
+    rdpq_set_scissor(0, 0, 640, 480);
+}
+
+void library_ui_text (int font, int style, float x, float baseline, float width, rdpq_align_t align, const char *str) {
+    text(font, style, x, baseline, width, align, str);
+}
+
+static void dim_area (float x0, float y0, float x1, float y1) {
+    rdpq_set_mode_standard();
+    rdpq_mode_combiner(RDPQ_COMBINER_FLAT);
+    rdpq_mode_blender(RDPQ_BLENDER_MULTIPLY);
+    rdpq_set_prim_color(RGBA32(0x0A, 0x0A, 0x0B, 0xB0));
+    rdpq_fill_rectangle(x0, y0, x1, y1);
+}
+
+
+// ---------------------------------------------------------------------------
+// Init / frame
+
+void library_ui_init (void) {
+    if (initialized) {
+        return;
+    }
+    spr_cart_sel = sprite_load("rom:/lib-cart-sel.sprite");
+    spr_cart_small = sprite_load("rom:/lib-cart-small.sprite");
+    spr_disk_sel = sprite_load("rom:/lib-disk-sel.sprite");
+    spr_disk_small = sprite_load("rom:/lib-disk-small.sprite");
+    spr_btn[0] = sprite_load("rom:/lib-btn-a.sprite");
+    spr_btn[1] = sprite_load("rom:/lib-btn-b.sprite");
+    spr_btn[2] = sprite_load("rom:/lib-btn-right.sprite");
+    spr_btn[3] = sprite_load("rom:/lib-btn-up.sprite");
+    spr_icon[LIB_TAB_LIBRARY] = sprite_load("rom:/lib-icon-library.sprite");
+    spr_icon[LIB_TAB_HISTORY] = sprite_load("rom:/lib-icon-history.sprite");
+    spr_icon[LIB_TAB_FAVORITES] = sprite_load("rom:/lib-icon-favorites.sprite");
+    spr_icon[LIB_TAB_SETTINGS] = sprite_load("rom:/lib-icon-settings.sprite");
+    initialized = true;
+}
+
+void library_ui_begin (surface_t *display) {
+    library_ui_init();
+    label_loads_this_frame = 0;
+    rdpq_attach_clear(display, NULL);
+    fill(0, 0, display->width, display->height, COLOR_BG);
+}
+
+void library_ui_end (void) {
+    rdpq_detach_show();
+}
+
+
+// ---------------------------------------------------------------------------
+// Header / footer
+
+static void draw_icon (lib_tab_t tab, float x, float y, bool active) {
+    // Icons are white pixel art; inactive ones get a grey wash by drawing them then dimming.
+    blit_sprite(spr_icon[tab], x, y, 1.0f, 4.0f / 3.0f, false);
+    if (!active) {
+        rdpq_set_mode_standard();
+        rdpq_mode_combiner(RDPQ_COMBINER_FLAT);
+        rdpq_mode_blender(RDPQ_BLENDER_MULTIPLY);
+        rdpq_set_prim_color(RGBA32(0x0A, 0x0A, 0x0B, 0x60));
+        rdpq_fill_rectangle(x, y, x + 15, y + 20);
+    }
+}
+
+void library_ui_header (lib_tab_t tab) {
+    float x = DX(400);
+    float y = DY(36);
+    for (int i = 0; i < LIB_TAB_COUNT; i++) {
+        bool active = (i == (int)tab);
+        draw_icon(i, x, y, active);
+        x += 15;
+        if (active) {
+            x += DX(14);
+            text(FNT_LIB_SANS, STL_DEFAULT, x, y + 17, 0, ALIGN_LEFT, tab_names[i]);
+            rdpq_textmetrics_t m = rdpq_text_print(&(rdpq_textparms_t) { .style_id = STL_DEFAULT }, FNT_LIB_SANS, -1000, -1000, tab_names[i]);
+            x += m.advance_x;
+        }
+        x += DX(32);
+    }
+
+    // L | R badge
+    float bx = DX(1280 - 64) - 30;
+    float by = DY(40);
+    fill(bx, by, bx + 14, by + 16, COLOR_BADGE);
+    fill(bx + 16, by, bx + 30, by + 16, COLOR_BADGE);
+    text(FNT_LIB_MONO, STL_BLACK, bx, by + 13, 14, ALIGN_CENTER, "L");
+    text(FNT_LIB_MONO, STL_BLACK, bx + 16, by + 13, 14, ALIGN_CENTER, "R");
+}
+
+static float draw_button (lib_button_t button, float x, float y) {
+    switch (button) {
+        case LIB_BTN_A: blit_sprite(spr_btn[0], x, y, 1.0f, 4.0f / 3.0f, false); return 17;
+        case LIB_BTN_B: blit_sprite(spr_btn[1], x, y, 1.0f, 4.0f / 3.0f, false); return 17;
+        case LIB_BTN_C_RIGHT: blit_sprite(spr_btn[2], x, y, 1.0f, 4.0f / 3.0f, false); return 17;
+        case LIB_BTN_C_UP: blit_sprite(spr_btn[3], x, y, 1.0f, 4.0f / 3.0f, false); return 17;
+        case LIB_BTN_Z:
+            rounded(x, y + 2, x + 17, y + 21, 5, COLOR_WHITE);
+            text(FNT_LIB_MONO, STL_BLACK, x, y + 17, 17, ALIGN_CENTER, "Z");
+            return 17;
+        case LIB_BTN_LR:
+            fill(x, y + 3, x + 13, y + 19, COLOR_BADGE);
+            fill(x + 15, y + 3, x + 28, y + 19, COLOR_BADGE);
+            text(FNT_LIB_MONO, STL_BLACK, x, y + 16, 13, ALIGN_CENTER, "L");
+            text(FNT_LIB_MONO, STL_BLACK, x + 15, y + 16, 13, ALIGN_CENTER, "R");
+            return 28;
+        case LIB_BTN_C_LR:
+            rounded(x, y + 2, x + 30, y + 21, 5, COLOR_WHITE);
+            text(FNT_LIB_MONO, STL_BLACK, x, y + 17, 30, ALIGN_CENTER, "C<>");
+            return 30;
+        case LIB_BTN_DPAD:
+            rounded(x, y + 2, x + 24, y + 21, 5, COLOR_WHITE);
+            text(FNT_LIB_MONO, STL_BLACK, x, y + 17, 24, ALIGN_CENTER, "<>");
+            return 24;
+    }
+    return 0;
+}
+
+void library_ui_footer (menu_t *menu, int hint_count, const lib_button_t *buttons, const char *const *texts) {
+    // Controller dots: one per port, bright when connected.
+    float dx = DX(64);
+    float dy = DY(675);
+    for (int port = 0; port < 4; port++) {
+        bool connected = joypad_is_connected(port);
+        rounded(dx, dy, dx + 6, dy + 8, 4, connected ? COLOR_WHITE : COLOR_DOT_OFF);
+        dx += 10;
+    }
+
+    // Button hints from the info column.
+    float hx = DX(LIB_COLUMN_X);
+    float hy = DY(668);
+    const float clock_left = DX(1280 - 64) - 84;
+    // If the hints are wider than the space before the clock, start them further left.
+    float total = 0;
+    for (int i = 0; i < hint_count; i++) {
+        int bw = (buttons[i] == LIB_BTN_LR || buttons[i] == LIB_BTN_C_LR) ? 30 : (buttons[i] == LIB_BTN_DPAD ? 24 : 17);
+        total += bw + 6 + text_width(FNT_LIB_SANS, STL_DEFAULT, texts[i]) + (i ? DX(36) : 0);
+    }
+    if (hx + total > clock_left) {
+        hx = clock_left - total;
+        if (hx < DX(160)) hx = DX(160);
+    }
+    hx = floorf(hx);
+    for (int i = 0; i < hint_count; i++) {
+        float tw = text_width(FNT_LIB_SANS, STL_DEFAULT, texts[i]);
+        if (hx + 23 + tw > clock_left) {
+            break;  // never run into the clock
+        }
+        hx += draw_button(buttons[i], hx, hy);
+        hx += 6;
+        text(FNT_LIB_SANS, STL_DEFAULT, hx, hy + 18, 0, ALIGN_LEFT, texts[i]);
+        hx += tw + DX(36);
+    }
+
+    // Clock (12-hour, like 3DOS).
+    if (menu->current_time >= 0) {
+        struct tm *tm = localtime(&menu->current_time);
+        if (tm) {
+            char buf[16];
+            int hour = tm->tm_hour % 12;
+            snprintf(buf, sizeof(buf), "%d:%02d %s", hour == 0 ? 12 : hour, tm->tm_min, tm->tm_hour < 12 ? "AM" : "PM");
+            text(FNT_LIB_SANS, STL_DEFAULT, DX(1280 - 64) - 120, hy + 18, 120, ALIGN_RIGHT, buf);
+        }
+    }
+}
