diff --git a/src/menu/views/label_picker.c b/src/menu/views/label_picker.c
new file mode 100644
index 0000000..cc7bb4f
--- /dev/null
+++ b/src/menu/views/label_picker.c
@@ -0,0 +1,247 @@
+/**
+ * @file label_picker.c
+ * @brief Choose a cartridge label from labels.db for the current game.
+ * @ingroup view
+ */
+
+#include <string.h>
+
+#include "../fonts.h"
+#include "../labels_db.h"
+#include "../sound.h"
+#include "../ui_components/library_ui.h"
+#include "views.h"
+
+#define COLUMNS         (7)
+#define ROWS            (2)
+#define PER_PAGE        (COLUMNS * ROWS)
+
+// Grid geometry in design units (1280x720).
+#define CELL_W          (140)
+#define CELL_H          (196)
+#define GRID_X          ((1280 - COLUMNS * CELL_W) / 2)
+#define GRID_Y          (150)
+
+static int selected = 0;
+static int last_selected = 0;    // where the picker was left, for games with no label yet
+static int page_loaded = -1;
+static surface_t page_surfaces[PER_PAGE];
+static bool page_found[PER_PAGE];
+static int page_next_load = 0;
+static char game_title[96];
+static bool has_current = false;
+static uint32_t current_id = 0;
+
+
+static void page_free (void) {
+    rspq_wait();
+    for (int i = 0; i < PER_PAGE; i++) {
+        if (page_found[i]) {
+            surface_free(&page_surfaces[i]);
+        }
+        page_found[i] = false;
+    }
+    page_loaded = -1;
+    page_next_load = 0;
+}
+
+static void page_prepare (int page) {
+    if (page != page_loaded) {
+        page_free();
+        page_loaded = page;
+        page_next_load = 0;
+    }
+    // Load two labels per frame so paging stays responsive.
+    for (int n = 0; n < 2 && page_next_load < PER_PAGE; n++, page_next_load++) {
+        int index = page * PER_PAGE + page_next_load;
+        if (index < labels_db_count()) {
+            page_found[page_next_load] = labels_db_load_index(index, &page_surfaces[page_next_load]);
+        }
+    }
+}
+
+static void process (menu_t *menu) {
+    int count = labels_db_count();
+    if (count == 0) {
+        if (menu->actions.back || menu->actions.enter) {
+            menu->next_mode = MENU_MODE_LIBRARY_CONFIG;
+            sound_play_effect(SFX_EXIT);
+        }
+        return;
+    }
+
+    int previous = selected;
+
+    if (menu->actions.l) {
+        selected -= PER_PAGE;
+    } else if (menu->actions.r) {
+        selected += PER_PAGE;
+    } else if (menu->actions.c_left) {
+        selected -= PER_PAGE * 10;
+    } else if (menu->actions.c_right) {
+        selected += PER_PAGE * 10;
+    } else if (menu->actions.go_fast && menu->actions.go_up) {
+        selected -= PER_PAGE;
+    } else if (menu->actions.go_fast && menu->actions.go_down) {
+        selected += PER_PAGE;
+    } else if (menu->actions.go_left && !menu->actions.go_fast) {
+        selected -= 1;
+    } else if (menu->actions.go_right && !menu->actions.go_fast) {
+        selected += 1;
+    } else if (menu->actions.go_up) {
+        selected -= COLUMNS;
+    } else if (menu->actions.go_down) {
+        selected += COLUMNS;
+    }
+
+    if (selected < 0) selected = 0;
+    if (selected > count - 1) selected = count - 1;
+    if (selected != previous) {
+        sound_play_effect(SFX_CURSOR);
+    }
+    last_selected = selected;
+
+    if (menu->actions.enter && menu->load.rom_path) {
+        labels_override_set(path_get(menu->load.rom_path), labels_db_id_at(selected));
+        library_label_cache_clear();
+        sound_play_effect(SFX_ENTER);
+        menu->next_mode = MENU_MODE_LIBRARY_CONFIG;
+    } else if (menu->actions.z && menu->load.rom_path && has_current) {
+        labels_override_clear(path_get(menu->load.rom_path));
+        library_label_cache_clear();
+        sound_play_effect(SFX_SETTING);
+        menu->next_mode = MENU_MODE_LIBRARY_CONFIG;
+    } else if (menu->actions.back) {
+        sound_play_effect(SFX_EXIT);
+        menu->next_mode = MENU_MODE_LIBRARY_CONFIG;
+    }
+}
+
+static void draw (menu_t *menu, surface_t *display) {
+    library_ui_begin(display);
+
+    char heading[128];
+    snprintf(heading, sizeof(heading), "Choose Label: %s", game_title);
+    library_ui_text(FNT_LIB_SANS, STL_DEFAULT, DX(64), DY(70), DX(1280 - 2 * 64 - 320), ALIGN_LEFT, heading);
+
+    int count = labels_db_count();
+    if (count == 0) {
+        library_ui_message("No labels.db found. Copy it from the Analogue 3D card to /menu/labels.db");
+        const lib_button_t b[] = { LIB_BTN_B };
+        const char *t[] = { "Back" };
+        library_ui_footer(menu, 1, b, t);
+        library_ui_end();
+        return;
+    }
+
+    int page = selected / PER_PAGE;
+    int pages = (count + PER_PAGE - 1) / PER_PAGE;
+    page_prepare(page);
+
+    char counter[48];
+    snprintf(counter, sizeof(counter), "PAGE %d OF %d", page + 1, pages);
+    library_ui_text(FNT_LIB_SANS, STL_DEFAULT, DX(1280 - 64 - 300), DY(70), DX(300), ALIGN_RIGHT, counter);
+    snprintf(counter, sizeof(counter), "LABEL %d OF %d", selected + 1, count);
+    library_ui_text(FNT_LIB_MONO, STL_DIM, DX(1280 - 64 - 300), DY(100), DX(300), ALIGN_RIGHT, counter);
+
+    // Position bar: the whole of labels.db, with this page highlighted.
+    {
+        float bx0 = DX(64), bx1 = DX(1280 - 64), by = DY(600);
+        rdpq_set_mode_fill(RGBA32(0x3A, 0x3A, 0x40, 0xFF));
+        rdpq_fill_rectangle(bx0, by, bx1, by + 3);
+        float w = (bx1 - bx0) / (float)pages;
+        if (w < 4) w = 4;
+        float px = bx0 + (bx1 - bx0 - w) * (pages > 1 ? (float)page / (float)(pages - 1) : 0);
+        rdpq_set_mode_fill(RGBA32(0xF2, 0xF2, 0xF2, 0xFF));
+        rdpq_fill_rectangle(px, by - 2, px + w, by + 5);
+    }
+
+    for (int i = 0; i < PER_PAGE; i++) {
+        int index = page * PER_PAGE + i;
+        if (index >= count) {
+            break;
+        }
+        int col = i % COLUMNS;
+        int row = i / COLUMNS;
+        float cx = GRID_X + col * CELL_W;
+        float cy = GRID_Y + row * CELL_H;
+
+        // Label 74x86 shown at 110x128 design units.
+        float lx = DX(cx + (CELL_W - 110) / 2);
+        float ly = DY(cy + (CELL_H - 128) / 2);
+        float lw = DX(110), lh = DY(128);
+
+        if (index == selected) {
+            rdpq_set_mode_fill(RGBA32(0xFF, 0xFF, 0xFF, 0xFF));
+            rdpq_fill_rectangle(lx - 4, ly - 5, lx + lw + 4, ly + lh + 5);
+            rdpq_set_mode_fill(RGBA32(0x0A, 0x0A, 0x0B, 0xFF));
+            rdpq_fill_rectangle(lx - 2, ly - 3, lx + lw + 2, ly + lh + 3);
+        }
+
+        if (i < page_next_load && page_found[i]) {
+            rdpq_set_mode_standard();
+            rdpq_mode_filter(FILTER_BILINEAR);
+            rdpq_tex_blit(&page_surfaces[i], lx, ly, &(rdpq_blitparms_t) {
+                .scale_x = lw / (float)LABEL_WIDTH,
+                .scale_y = lh / (float)LABEL_HEIGHT,
+                .filtering = true,
+            });
+        } else {
+            rdpq_set_mode_fill(RGBA32(0x5E, 0x5E, 0x66, 0xFF));
+            rdpq_fill_rectangle(lx, ly, lx + lw, ly + lh);
+        }
+
+        if (has_current && labels_db_id_at(index) == current_id) {
+            rdpq_text_print(&(rdpq_textparms_t) { .style_id = STL_DEFAULT, .width = lw, .align = ALIGN_CENTER },
+                FNT_LIB_MONO, lx, ly + lh + 16, "CURRENT");
+        }
+    }
+
+    if (has_current) {
+        const lib_button_t b[] = { LIB_BTN_A, LIB_BTN_LR, LIB_BTN_C_LR, LIB_BTN_Z, LIB_BTN_B };
+        const char *t[] = { "Use", "Page", "10 Pages", "Clear", "Back" };
+        library_ui_footer(menu, 5, b, t);
+    } else {
+        const lib_button_t b[] = { LIB_BTN_A, LIB_BTN_LR, LIB_BTN_C_LR, LIB_BTN_B };
+        const char *t[] = { "Use Label", "Page", "10 Pages", "Back" };
+        library_ui_footer(menu, 4, b, t);
+    }
+
+    library_ui_end();
+}
+
+void view_label_picker_init (menu_t *menu) {
+    page_free();
+    selected = last_selected;   // carry on from where you left off
+    has_current = false;
+    game_title[0] = 0;
+
+    if (menu->load.rom_path) {
+        library_clean_title(path_last_get(menu->load.rom_path), game_title, sizeof(game_title));
+
+        // Start on the label this game already uses (chosen or its own), else the first one.
+        uint32_t id;
+        bool known = false;
+        current_id = 0;
+        if (labels_override_get(path_get(menu->load.rom_path), &id)) {
+            has_current = true;
+            current_id = id;
+            known = true;
+        } else if (labels_db_rom_id(path_get(menu->load.rom_path), &id)) {
+            current_id = id;
+            known = true;
+        }
+        int index = known ? labels_db_index_of(current_id) : -1;
+        if (index >= 0) {
+            selected = index;
+        }
+    }
+}
+
+void view_label_picker_display (menu_t *menu, surface_t *display) {
+    process(menu);
+    draw(menu, display);
+    if (menu->next_mode != MENU_MODE_LABEL_PICKER) {
+        page_free();
+    }
+}
diff --git a/src/menu/views/library_configure.c b/src/menu/views/library_configure.c
new file mode 100644
index 0000000..78e8a21
--- /dev/null
+++ b/src/menu/views/library_configure.c
@@ -0,0 +1,359 @@
+/**
+ * @file library_configure.c
+ * @brief 3DOS-style per-game Configure screen (C-right in the Library).
+ * @ingroup view
+ */
+
+#include <stdio.h>
+#include <string.h>
+
+#include "../bookkeeping.h"
+#include "../fonts.h"
+#include "../labels_db.h"
+#include "../sound.h"
+#include "../ui_components/library_ui.h"
+#include "views.h"
+
+typedef enum {
+    CAT_HARDWARE,
+    CAT_CHEATS,
+    CAT_CUSTOMIZATION,
+    CAT_ROM_INFO,
+    CAT_COUNT,
+} category_t;
+
+static const char *category_names[CAT_COUNT] = { "Hardware", "Cheats", "Customization", "ROM Info" };
+
+typedef struct { const char *name; int value; } choice_t;
+
+static const choice_t cic_choices[] = {
+    { "Automatic", ROM_CIC_TYPE_AUTOMATIC }, { "6101", ROM_CIC_TYPE_6101 }, { "7102", ROM_CIC_TYPE_7102 },
+    { "6102 / 7101", ROM_CIC_TYPE_x102 }, { "6103 / 7103", ROM_CIC_TYPE_x103 }, { "6105 / 7105", ROM_CIC_TYPE_x105 },
+    { "6106 / 7106", ROM_CIC_TYPE_x106 }, { "Aleck64 5101", ROM_CIC_TYPE_5101 }, { "64DD conv. 5167", ROM_CIC_TYPE_5167 },
+    { "NDDJ0 IPL", ROM_CIC_TYPE_8301 }, { "NDDJ1 IPL", ROM_CIC_TYPE_8302 }, { "NDDJ2 IPL", ROM_CIC_TYPE_8303 },
+    { "NDXJ0 IPL", ROM_CIC_TYPE_8401 }, { "NDDE0 IPL", ROM_CIC_TYPE_8501 },
+};
+static const choice_t save_choices[] = {
+    { "Automatic", SAVE_TYPE_AUTOMATIC }, { "None", SAVE_TYPE_NONE }, { "EEPROM 4K", SAVE_TYPE_EEPROM_4KBIT },
+    { "EEPROM 16K", SAVE_TYPE_EEPROM_16KBIT }, { "SRAM 256K", SAVE_TYPE_SRAM_256KBIT }, { "SRAM 768K", SAVE_TYPE_SRAM_BANKED },
+    { "SRAM 1M", SAVE_TYPE_SRAM_1MBIT }, { "FlashRAM 1M", SAVE_TYPE_FLASHRAM_1MBIT },
+};
+static const choice_t tv_choices[] = {
+    { "Automatic", ROM_TV_TYPE_AUTOMATIC }, { "PAL", ROM_TV_TYPE_PAL }, { "NTSC", ROM_TV_TYPE_NTSC }, { "MPAL", ROM_TV_TYPE_MPAL },
+};
+#define COUNT(a) ((int)(sizeof(a) / sizeof((a)[0])))
+
+static category_t category = CAT_HARDWARE;
+static bool rows_focused = false;
+static int row = 0;
+static bool loaded = false;
+static char title[128];
+static char message[96];
+static int message_frames = 0;
+
+static int choice_index (const choice_t *list, int count, int value) {
+    for (int i = 0; i < count; i++) {
+        if (list[i].value == value) return i;
+    }
+    return 0;
+}
+
+static int favorite_slot (menu_t *menu) {
+    for (int i = 0; i < FAVORITES_COUNT; i++) {
+        bookkeeping_item_t *it = &menu->bookkeeping.favorite_items[i];
+        if (it->bookkeeping_type != BOOKKEEPING_TYPE_EMPTY && path_has_value(it->primary_path)
+            && strcmp(path_get(it->primary_path), path_get(menu->load.rom_path)) == 0) {
+            return i;
+        }
+    }
+    return -1;
+}
+
+static void flash (const char *text) {
+    snprintf(message, sizeof(message), "%s", text);
+    message_frames = 90;
+}
+
+static int row_count (void) {
+    switch (category) {
+        case CAT_HARDWARE: return 4;
+        case CAT_CHEATS: return 2;
+        case CAT_CUSTOMIZATION: return 3;
+        case CAT_ROM_INFO: return 12;
+        default: return 0;
+    }
+}
+
+static void cycle (menu_t *menu, int direction) {
+    rom_info_t *ri = &menu->load.rom_info;
+    rom_err_t err = ROM_OK;
+    if (category == CAT_HARDWARE) {
+        if (row == 0) {
+            int i = ri->boot_override.cic ? choice_index(cic_choices, COUNT(cic_choices), ri->boot_override.cic_type) : 0;
+            i = (i + direction + COUNT(cic_choices)) % COUNT(cic_choices);
+            err = rom_config_override_cic_type(menu->load.rom_path, ri, cic_choices[i].value);
+        } else if (row == 1) {
+            int i = ri->boot_override.save ? choice_index(save_choices, COUNT(save_choices), ri->boot_override.save_type) : 0;
+            i = (i + direction + COUNT(save_choices)) % COUNT(save_choices);
+            err = rom_config_override_save_type(menu->load.rom_path, ri, save_choices[i].value);
+        } else if (row == 2) {
+            int i = ri->boot_override.tv ? choice_index(tv_choices, COUNT(tv_choices), ri->boot_override.tv_type) : 0;
+            i = (i + direction + COUNT(tv_choices)) % COUNT(tv_choices);
+            err = rom_config_override_tv_type(menu->load.rom_path, ri, tv_choices[i].value);
+        } else if (row == 3) {
+            err = rom_config_setting_set_clear_rdram(menu->load.rom_path, ri, !ri->settings.clear_rdram_enabled);
+        }
+    } else if (category == CAT_CHEATS && row == 0) {
+        if (!is_memory_expanded()) {
+            rom_config_setting_set_cheats(menu->load.rom_path, ri, false);
+            flash("Cheats need an Expansion Pak");
+            sound_play_effect(SFX_ERROR);
+            return;
+        }
+        err = rom_config_setting_set_cheats(menu->load.rom_path, ri, !ri->settings.cheats_enabled);
+    } else if (category == CAT_CUSTOMIZATION && row == 1) {
+        int slot = favorite_slot(menu);
+        if (slot >= 0) {
+            bookkeeping_favorite_remove(&menu->bookkeeping, slot);
+        } else {
+            bookkeeping_favorite_add(&menu->bookkeeping, menu->load.rom_path, NULL, BOOKKEEPING_TYPE_ROM);
+        }
+    } else {
+        return;
+    }
+    if (err != ROM_OK) {
+        flash("Couldn't save this setting");
+        sound_play_effect(SFX_ERROR);
+    } else {
+        sound_play_effect(SFX_SETTING);
+    }
+}
+
+static void activate (menu_t *menu) {
+    if (category == CAT_CHEATS && row == 1) {
+        if (!is_memory_expanded()) {
+            flash("Cheats need an Expansion Pak");
+            sound_play_effect(SFX_ERROR);
+            return;
+        }
+        menu->next_mode = MENU_MODE_DATEL_CODE_EDITOR;
+        sound_play_effect(SFX_ENTER);
+    } else if (category == CAT_CUSTOMIZATION && row == 0) {
+        menu->next_mode = MENU_MODE_LABEL_PICKER;
+        sound_play_effect(SFX_ENTER);
+    } else if (category == CAT_CUSTOMIZATION && row == 2) {
+        labels_override_clear(path_get(menu->load.rom_path));
+        library_label_cache_clear();
+        flash("Label reset to the game's own");
+        sound_play_effect(SFX_SETTING);
+    } else {
+        cycle(menu, 1);
+    }
+}
+
+static void process (menu_t *menu) {
+    if (!loaded) {
+        if (menu->actions.back || menu->actions.enter) {
+            menu->next_mode = menu->load.return_mode;
+        }
+        return;
+    }
+
+    if (!rows_focused) {
+        if (menu->actions.go_up && category > 0) {
+            category--;
+            sound_play_effect(SFX_CURSOR);
+        } else if (menu->actions.go_down && category < CAT_COUNT - 1) {
+            category++;
+            sound_play_effect(SFX_CURSOR);
+        } else if (menu->actions.enter || menu->actions.go_right) {
+            rows_focused = true;
+            row = 0;
+            sound_play_effect(SFX_ENTER);
+        } else if (menu->actions.back) {
+            menu->next_mode = menu->load.return_mode;
+            sound_play_effect(SFX_EXIT);
+        }
+        return;
+    }
+
+    int n = row_count();
+    if (menu->actions.go_up && row > 0) {
+        row--;
+        sound_play_effect(SFX_CURSOR);
+    } else if (menu->actions.go_down && row < n - 1) {
+        row++;
+        sound_play_effect(SFX_CURSOR);
+    } else if (menu->actions.go_left && !menu->actions.go_fast) {
+        if (category == CAT_ROM_INFO || (category == CAT_CHEATS && row == 1) || (category == CAT_CUSTOMIZATION && row != 1)) {
+            rows_focused = false;
+            sound_play_effect(SFX_EXIT);
+        } else {
+            cycle(menu, -1);
+        }
+    } else if (menu->actions.go_right && !menu->actions.go_fast) {
+        cycle(menu, 1);
+    } else if (menu->actions.enter) {
+        activate(menu);
+    } else if (menu->actions.back) {
+        rows_focused = false;
+        sound_play_effect(SFX_EXIT);
+    }
+}
+
+static const char *cic_name (rom_info_t *ri) {
+    if (!ri->boot_override.cic) {
+        static char buf[32];
+        int i = choice_index(cic_choices, COUNT(cic_choices), ri->cic_type);
+        snprintf(buf, sizeof(buf), "Auto (%s)", i > 0 ? cic_choices[i].name : "?");
+        return buf;
+    }
+    return cic_choices[choice_index(cic_choices, COUNT(cic_choices), ri->boot_override.cic_type)].name;
+}
+
+static const char *save_name (rom_info_t *ri) {
+    if (!ri->boot_override.save) {
+        static char buf[32];
+        snprintf(buf, sizeof(buf), "Auto (%s)", save_choices[choice_index(save_choices, COUNT(save_choices), ri->save_type)].name);
+        return buf;
+    }
+    return save_choices[choice_index(save_choices, COUNT(save_choices), ri->boot_override.save_type)].name;
+}
+
+static const char *tv_name (rom_info_t *ri) {
+    if (!ri->boot_override.tv) {
+        static char buf[32];
+        int i = choice_index(tv_choices, COUNT(tv_choices), ri->tv_type);
+        snprintf(buf, sizeof(buf), "Auto (%s)", i > 0 ? tv_choices[i].name : "?");
+        return buf;
+    }
+    return tv_choices[choice_index(tv_choices, COUNT(tv_choices), ri->boot_override.tv_type)].name;
+}
+
+static void draw (menu_t *menu, surface_t *display) {
+    library_ui_begin(display);
+
+    if (!loaded) {
+        library_ui_message("Couldn't read this game's details");
+        const lib_button_t b[] = { LIB_BTN_B };
+        const char *t[] = { "Back" };
+        library_ui_footer(menu, 1, b, t);
+        library_ui_end();
+        return;
+    }
+
+    rom_info_t *ri = &menu->load.rom_info;
+    lib_row_t rows[12];
+    memset(rows, 0, sizeof(rows));
+    int n = 0;
+    char b[12][48];
+
+    switch (category) {
+        case CAT_HARDWARE:
+            rows[n++] = (lib_row_t) { .section = "CARTRIDGE OVERRIDES", .label = "CIC Type", .value = cic_name(ri), .kind = LIB_ROW_CHOICE };
+            rows[n++] = (lib_row_t) { .label = "Save Type", .value = save_name(ri), .kind = LIB_ROW_CHOICE };
+            rows[n++] = (lib_row_t) { .label = "TV Type", .value = tv_name(ri), .kind = LIB_ROW_CHOICE };
+            rows[n++] = (lib_row_t) { .section = "LAUNCH", .label = "Clear RAM on Boot", .kind = LIB_ROW_TOGGLE, .on = ri->settings.clear_rdram_enabled };
+            break;
+        case CAT_CHEATS:
+            rows[n++] = (lib_row_t) { .section = "DATEL", .label = "Use Cheats", .kind = LIB_ROW_TOGGLE, .on = ri->settings.cheats_enabled, .disabled = !is_memory_expanded() };
+            rows[n++] = (lib_row_t) { .label = "Datel Code Editor", .value = ">", .kind = LIB_ROW_ACTION, .disabled = !is_memory_expanded() };
+            break;
+        case CAT_CUSTOMIZATION:
+            rows[n++] = (lib_row_t) { .section = "LIBRARY", .label = "Choose Label", .value = ">", .kind = LIB_ROW_ACTION };
+            rows[n++] = (lib_row_t) { .label = "Favorite", .kind = LIB_ROW_TOGGLE, .on = favorite_slot(menu) >= 0 };
+            rows[n++] = (lib_row_t) { .label = "Reset Label", .value = ">", .kind = LIB_ROW_ACTION };
+            break;
+        case CAT_ROM_INFO: {
+            snprintf(b[0], 48, "%.4s", ri->game_code);
+            snprintf(b[1], 48, "%u", ri->version);
+            snprintf(b[2], 48, "%d", (int)ri->cic_type);
+            snprintf(b[3], 48, "0x%016llX", (unsigned long long)ri->check_code);
+            snprintf(b[4], 48, "0x%08lX", (unsigned long)ri->boot_address);
+            snprintf(b[5], 48, "%d.%d%c", ri->libultra.version / 10, ri->libultra.version % 10, ri->libultra.revision);
+            snprintf(b[6], 48, "%.2f MHz", ri->clock_rate);
+            const char *endian = ri->endianness == ENDIANNESS_BIG ? "Big (z64)" : (ri->endianness == ENDIANNESS_BYTE_SWAP ? "Byte-swapped (v64)" : "Little (n64)");
+            const char *exp = ri->features.expansion_pak == EXPANSION_PAK_REQUIRED ? "Required"
+                            : ri->features.expansion_pak == EXPANSION_PAK_RECOMMENDED ? "Recommended"
+                            : ri->features.expansion_pak == EXPANSION_PAK_SUGGESTED ? "Suggested"
+                            : ri->features.expansion_pak == EXPANSION_PAK_FAULTY ? "Faulty" : "Not used";
+            rows[n++] = (lib_row_t) { .section = "CARTRIDGE", .label = "Game Code", .value = b[0], .mono = true };
+            rows[n++] = (lib_row_t) { .label = "Version", .value = b[1], .mono = true };
+            rows[n++] = (lib_row_t) { .label = "Expansion Pak", .value = exp, .mono = true };
+            rows[n++] = (lib_row_t) { .label = "Rumble Pak", .value = ri->features.rumble_pak ? "Yes" : "No", .mono = true };
+            rows[n++] = (lib_row_t) { .label = "Controller Pak", .value = ri->features.controller_pak ? "Yes" : "No", .mono = true };
+            rows[n++] = (lib_row_t) { .label = "Transfer Pak", .value = ri->features.transfer_pak ? "Yes" : "No", .mono = true };
+            rows[n++] = (lib_row_t) { .section = "TECHNICAL", .label = "CIC", .value = b[2], .mono = true };
+            rows[n++] = (lib_row_t) { .label = "Check Code", .value = b[3], .mono = true };
+            rows[n++] = (lib_row_t) { .label = "Boot Address", .value = b[4], .mono = true };
+            rows[n++] = (lib_row_t) { .label = "SDK Version", .value = b[5], .mono = true };
+            rows[n++] = (lib_row_t) { .label = "Clock Rate", .value = b[6], .mono = true };
+            rows[n++] = (lib_row_t) { .label = "Endianness", .value = endian, .mono = true };
+            break;
+        }
+        default:
+            break;
+    }
+
+    library_ui_config_page(title, category_names, CAT_COUNT, category, rows_focused, rows, n, row);
+
+    if (message_frames > 0) {
+        message_frames--;
+        library_ui_text(FNT_LIB_SANS, STL_DEFAULT, DX(LIB_COLUMN_X), DY(640), DX(700), ALIGN_LEFT, message);
+    }
+
+    if (!rows_focused) {
+        const lib_button_t bt[] = { LIB_BTN_A, LIB_BTN_B };
+        const char *t[] = { "Select", "Back" };
+        library_ui_footer(menu, 2, bt, t);
+    } else if (category == CAT_ROM_INFO) {
+        const lib_button_t bt[] = { LIB_BTN_B };
+        const char *t[] = { "Back" };
+        library_ui_footer(menu, 1, bt, t);
+    } else {
+        lib_row_t *r = &rows[row < n ? row : 0];
+        const lib_button_t bt[] = { LIB_BTN_A, LIB_BTN_B };
+        const char *t[] = { r->kind == LIB_ROW_ACTION ? "Open" : "Change", "Back" };
+        library_ui_footer(menu, 2, bt, t);
+    }
+
+    library_ui_end();
+}
+
+void view_library_configure_init (menu_t *menu) {
+    message_frames = 0;
+    loaded = false;
+
+    // Returning from the label picker / Datel editor keeps the current category.
+    bool returning = (category == CAT_CUSTOMIZATION || category == CAT_CHEATS) && rows_focused;
+    if (!returning) {
+        category = CAT_HARDWARE;
+        rows_focused = false;
+        row = 0;
+    }
+
+    if (!menu->load.rom_path) {
+        return;
+    }
+    rom_info_free_meta(&menu->load.rom_info);
+    if (rom_config_load(menu->load.rom_path, &menu->load.rom_info) != ROM_OK) {
+        return;
+    }
+    if (!is_memory_expanded()) {
+        menu->load.rom_info.settings.cheats_enabled = false;
+    }
+    char clean[96];
+    library_clean_title(path_last_get(menu->load.rom_path), clean, sizeof(clean));
+    snprintf(title, sizeof(title), "Configure [%s]", clean);
+    loaded = true;
+}
+
+void view_library_configure_display (menu_t *menu, surface_t *display) {
+    process(menu);
+    draw(menu, display);
+    if (menu->next_mode != MENU_MODE_LIBRARY_CONFIG && menu->next_mode != MENU_MODE_LABEL_PICKER
+        && menu->next_mode != MENU_MODE_DATEL_CODE_EDITOR) {
+        rows_focused = false;
+        category = CAT_HARDWARE;
+    }
+}
diff --git a/src/menu/views/library_general.c b/src/menu/views/library_general.c
new file mode 100644
index 0000000..65365e9
--- /dev/null
+++ b/src/menu/views/library_general.c
@@ -0,0 +1,260 @@
+/**
+ * @file library_general.c
+ * @brief 3DOS-style Settings > General: menu options and Library folder order.
+ * @ingroup view
+ */
+
+#include <stdio.h>
+#include <string.h>
+
+#include "../fonts.h"
+#include "../library_config.h"
+#include "../settings.h"
+#include "../sound.h"
+#include "../ui_components/library_ui.h"
+#include "views.h"
+
+typedef enum {
+    ROW_FOLDER_ORDER,
+    ROW_SHOW_HIDDEN,
+    ROW_SHOW_SAVES_FOLDER,
+    ROW_SHOW_SAVE_FILES,
+    ROW_SHOW_CHEAT_FILES,
+    ROW_USE_SAVES_FOLDER,
+    ROW_FAST_REBOOT,
+    ROW_PAL60,
+    ROW_SOUND_EFFECTS,
+    ROW_MUSIC,
+    ROW_RESET,
+    ROW_COUNT,
+} general_row_t;
+
+#define MAX_FOLDERS 16
+
+static int row = 0;
+static bool editing_order = false;
+static char folders[MAX_FOLDERS][48];
+static int folder_count = 0;
+static int folder_sel = 0;
+static bool folder_held = false;
+static bool confirm_reset = false;
+
+static void load_folders (menu_t *menu) {
+    // Root folders in their current Library order.
+    folder_count = 0;
+    char tmp[MAX_FOLDERS][48];
+    int n = 0;
+    path_t *root = path_init(menu->storage_prefix, "/");
+    dir_t info;
+    int r = dir_findfirst(path_get(root), &info);
+    while (r == 0 && n < MAX_FOLDERS) {
+        if (info.d_type == DT_DIR && info.d_name[0] != '.' && strcasecmp(info.d_name, "menu") != 0
+            && strcasecmp(info.d_name, "System Volume Information") != 0
+            && library_list_index(library_config_hide(), info.d_name) < 0) {
+            snprintf(tmp[n++], 48, "%s", info.d_name);
+        }
+        r = dir_findnext(path_get(root), &info);
+    }
+    path_free(root);
+
+    // Listed folders first, in order; then the rest alphabetically.
+    bool used[MAX_FOLDERS] = { false };
+    for (int pos = 0; pos < MAX_FOLDERS; pos++) {
+        for (int i = 0; i < n; i++) {
+            if (!used[i] && library_list_index(library_config_order(), tmp[i]) == pos) {
+                snprintf(folders[folder_count++], 48, "%s", tmp[i]);
+                used[i] = true;
+            }
+        }
+    }
+    for (;;) {
+        int best = -1;
+        for (int i = 0; i < n; i++) {
+            if (!used[i] && (best < 0 || strcasecmp(tmp[i], tmp[best]) < 0)) best = i;
+        }
+        if (best < 0) break;
+        snprintf(folders[folder_count++], 48, "%s", tmp[best]);
+        used[best] = true;
+    }
+}
+
+static void save_folders (menu_t *menu) {
+    char order[512] = { 0 };
+    for (int i = 0; i < folder_count; i++) {
+        if (i) strncat(order, ", ", sizeof(order) - strlen(order) - 1);
+        strncat(order, folders[i], sizeof(order) - strlen(order) - 1);
+    }
+    library_config_set_order(order);
+    menu->browser.reload = true;
+}
+
+static bool *toggle_for (menu_t *menu, int r) {
+    settings_t *s = &menu->settings;
+    switch (r) {
+        case ROW_SHOW_HIDDEN: return &s->show_protected_entries;
+        case ROW_SHOW_SAVES_FOLDER: return &s->show_saves_folder;
+        case ROW_SHOW_SAVE_FILES: return &s->show_save_files;
+        case ROW_SHOW_CHEAT_FILES: return &s->show_cheat_files;
+        case ROW_USE_SAVES_FOLDER: return &s->use_saves_folder;
+        case ROW_FAST_REBOOT: return &s->rom_fast_reboot_enabled;
+        case ROW_PAL60: return &s->pal60_enabled;
+        case ROW_SOUND_EFFECTS: return &s->soundfx_enabled;
+        case ROW_MUSIC: return &s->bgm_enabled;
+        default: return NULL;
+    }
+}
+
+static void flip (menu_t *menu, int r) {
+    bool *v = toggle_for(menu, r);
+    if (!v) return;
+
+    if (r == ROW_PAL60) {
+        if (get_tv_type() != TV_PAL) {
+            sound_play_effect(SFX_ERROR);
+            return;
+        }
+        *v = !*v;
+        vi_set_timing_preset(*v ? &VI_TIMING_PAL60 : &VI_TIMING_PAL);
+    } else {
+        *v = !*v;
+    }
+    if (r == ROW_SOUND_EFFECTS) sound_use_sfx(*v);
+    if (r == ROW_MUSIC) sound_use_bgm(*v);
+    if (r <= ROW_SHOW_CHEAT_FILES) menu->browser.reload = true;
+    settings_save(&menu->settings);
+    sound_play_effect(SFX_SETTING);
+}
+
+static void process (menu_t *menu) {
+    if (editing_order) {
+        if (menu->actions.go_up && folder_sel > 0) {
+            if (folder_held) {
+                char t[48]; memcpy(t, folders[folder_sel - 1], 48);
+                memcpy(folders[folder_sel - 1], folders[folder_sel], 48); memcpy(folders[folder_sel], t, 48);
+            }
+            folder_sel--;
+            sound_play_effect(SFX_CURSOR);
+        } else if (menu->actions.go_down && folder_sel < folder_count - 1) {
+            if (folder_held) {
+                char t[48]; memcpy(t, folders[folder_sel + 1], 48);
+                memcpy(folders[folder_sel + 1], folders[folder_sel], 48); memcpy(folders[folder_sel], t, 48);
+            }
+            folder_sel++;
+            sound_play_effect(SFX_CURSOR);
+        } else if (menu->actions.enter) {
+            folder_held = !folder_held;
+            if (!folder_held) save_folders(menu);
+            sound_play_effect(SFX_SETTING);
+        } else if (menu->actions.back) {
+            if (folder_held) {
+                folder_held = false;
+                save_folders(menu);
+            }
+            editing_order = false;
+            sound_play_effect(SFX_EXIT);
+        }
+        return;
+    }
+
+    if (confirm_reset) {
+        if (menu->actions.enter) {
+            settings_reset_to_defaults();
+            settings_load(&menu->settings);
+            sound_use_sfx(menu->settings.soundfx_enabled);
+            sound_use_bgm(menu->settings.bgm_enabled);
+            menu->browser.reload = true;
+            confirm_reset = false;
+            sound_play_effect(SFX_SETTING);
+        } else if (menu->actions.back) {
+            confirm_reset = false;
+            sound_play_effect(SFX_EXIT);
+        }
+        return;
+    }
+
+    if (menu->actions.go_up && row > 0) {
+        row--;
+        sound_play_effect(SFX_CURSOR);
+    } else if (menu->actions.go_down && row < ROW_COUNT - 1) {
+        row++;
+        sound_play_effect(SFX_CURSOR);
+    } else if (menu->actions.enter || ((menu->actions.go_left || menu->actions.go_right) && !menu->actions.go_fast && toggle_for(menu, row))) {
+        if (row == ROW_FOLDER_ORDER) {
+            load_folders(menu);
+            editing_order = true;
+            folder_sel = 0;
+            folder_held = false;
+            sound_play_effect(SFX_ENTER);
+        } else if (row == ROW_RESET) {
+            confirm_reset = true;
+            sound_play_effect(SFX_SETTING);
+        } else {
+            flip(menu, row);
+        }
+    } else if (menu->actions.back) {
+        menu->next_mode = MENU_MODE_LIBRARY_SETTINGS;
+        sound_play_effect(SFX_EXIT);
+    }
+}
+
+static void draw (menu_t *menu, surface_t *display) {
+    library_ui_begin(display);
+
+    static const char *categories[] = { "General" };
+
+    if (editing_order) {
+        lib_row_t rows[MAX_FOLDERS];
+        char labels[MAX_FOLDERS][56];
+        memset(rows, 0, sizeof(rows));
+        for (int i = 0; i < folder_count; i++) {
+            snprintf(labels[i], sizeof(labels[i]), "%d   %s", i + 1, folders[i]);
+            rows[i] = (lib_row_t) { .section = i == 0 ? "FOLDER ORDER" : NULL, .label = labels[i],
+                .value = (folder_held && i == folder_sel) ? "MOVING" : NULL, .kind = LIB_ROW_INFO };
+        }
+        library_ui_config_page("Folder Order", categories, 1, 0, true, rows, folder_count, folder_sel);
+        const lib_button_t b[] = { LIB_BTN_A, LIB_BTN_B };
+        const char *t[] = { folder_held ? "Drop" : "Pick Up", "Done" };
+        library_ui_footer(menu, 2, b, t);
+        library_ui_end();
+        return;
+    }
+
+    char order_preview[96];
+    snprintf(order_preview, sizeof(order_preview), "%s", library_config_order());
+
+    lib_row_t rows[ROW_COUNT];
+    memset(rows, 0, sizeof(rows));
+    rows[ROW_FOLDER_ORDER] = (lib_row_t) { .section = "LIBRARY", .label = "Folder Order", .value = order_preview, .kind = LIB_ROW_ACTION };
+    rows[ROW_SHOW_HIDDEN] = (lib_row_t) { .section = "BROWSER", .label = "Show Hidden Files", .kind = LIB_ROW_TOGGLE };
+    rows[ROW_SHOW_SAVES_FOLDER] = (lib_row_t) { .label = "Show Saves Folder", .kind = LIB_ROW_TOGGLE };
+    rows[ROW_SHOW_SAVE_FILES] = (lib_row_t) { .label = "Show Save Files", .kind = LIB_ROW_TOGGLE };
+    rows[ROW_SHOW_CHEAT_FILES] = (lib_row_t) { .label = "Show Cheat Files", .kind = LIB_ROW_TOGGLE };
+    rows[ROW_USE_SAVES_FOLDER] = (lib_row_t) { .section = "SAVES & BOOT", .label = "Use Saves Folder", .kind = LIB_ROW_TOGGLE };
+    rows[ROW_FAST_REBOOT] = (lib_row_t) { .label = "Fast Reboot ROM", .kind = LIB_ROW_TOGGLE };
+    rows[ROW_PAL60] = (lib_row_t) { .label = "PAL60 Mode", .kind = LIB_ROW_TOGGLE, .disabled = get_tv_type() != TV_PAL };
+    rows[ROW_SOUND_EFFECTS] = (lib_row_t) { .section = "SOUND", .label = "Sound Effects", .kind = LIB_ROW_TOGGLE };
+    rows[ROW_MUSIC] = (lib_row_t) { .label = "Background Music", .kind = LIB_ROW_TOGGLE };
+    rows[ROW_RESET] = (lib_row_t) { .section = "RESET", .label = confirm_reset ? "Press A again to reset all settings" : "Reset Menu Settings", .value = ">", .kind = LIB_ROW_ACTION };
+    for (int r = 0; r < ROW_COUNT; r++) {
+        bool *v = toggle_for(menu, r);
+        if (v) rows[r].on = *v;
+    }
+
+    library_ui_config_page("Menu Settings", categories, 1, 0, true, rows, ROW_COUNT, row);
+
+    const lib_button_t b[] = { LIB_BTN_A, LIB_BTN_B };
+    const char *t[] = { "Change", "Back" };
+    library_ui_footer(menu, 2, b, t);
+    library_ui_end();
+}
+
+void view_library_general_init (menu_t *menu) {
+    editing_order = false;
+    folder_held = false;
+    confirm_reset = false;
+}
+
+void view_library_general_display (menu_t *menu, surface_t *display) {
+    process(menu);
+    draw(menu, display);
+}
diff --git a/src/menu/views/library_settings.c b/src/menu/views/library_settings.c
new file mode 100644
index 0000000..9dc3526
--- /dev/null
+++ b/src/menu/views/library_settings.c
@@ -0,0 +1,80 @@
+/**
+ * @file library_settings.c
+ * @brief Settings tab of the Library: a 3DOS-style list that opens the menu's settings screens.
+ * @ingroup view
+ */
+
+#include "../sound.h"
+#include "../ui_components/library_ui.h"
+#include "views.h"
+
+typedef struct {
+    const char *text;
+    menu_mode_t mode;
+} settings_entry_t;
+
+static const settings_entry_t entries[] = {
+    { "Menu Settings", MENU_MODE_LIBRARY_GENERAL },
+    { "Date & Time", MENU_MODE_RTC },
+    { "Controller Pak", MENU_MODE_CONTROLLER_PAKFS },
+    { "Flashcart Information", MENU_MODE_FLASHCART },
+    { "N64 Information", MENU_MODE_SYSTEM_INFO },
+    { "About", MENU_MODE_CREDITS },
+};
+#define ENTRY_COUNT ((int)(sizeof(entries) / sizeof(entries[0])))
+
+static int selected = 0;
+
+static void set_tab (menu_t *menu, int direction) {
+    static const menu_mode_t order[4] = { MENU_MODE_BROWSER, MENU_MODE_HISTORY, MENU_MODE_FAVORITE, MENU_MODE_LIBRARY_SETTINGS };
+    menu->next_mode = order[(3 + direction + 4) % 4];
+    sound_play_effect(SFX_CURSOR);
+}
+
+static void process (menu_t *menu) {
+    if (menu->actions.l) {
+        set_tab(menu, -1);
+    } else if (menu->actions.r) {
+        set_tab(menu, 1);
+    } else if (menu->actions.back) {
+        menu->next_mode = MENU_MODE_BROWSER;
+        sound_play_effect(SFX_EXIT);
+    } else if (menu->actions.go_up && selected > 0) {
+        selected--;
+        sound_play_effect(SFX_CURSOR);
+    } else if (menu->actions.go_down && selected < ENTRY_COUNT - 1) {
+        selected++;
+        sound_play_effect(SFX_CURSOR);
+    } else if (menu->actions.enter) {
+        menu->next_mode = entries[selected].mode;
+        sound_play_effect(SFX_ENTER);
+    }
+}
+
+static void draw (menu_t *menu, surface_t *display) {
+    library_ui_begin(display);
+    library_ui_header(LIB_TAB_SETTINGS);
+
+    const char *items[ENTRY_COUNT];
+    for (int i = 0; i < ENTRY_COUNT; i++) {
+        items[i] = entries[i].text;
+    }
+    library_ui_settings_list("SYSTEM", items, ENTRY_COUNT, selected);
+
+    const lib_button_t b[] = { LIB_BTN_A, LIB_BTN_B };
+    const char *t[] = { "Open", "Back" };
+    library_ui_footer(menu, 2, b, t);
+
+    library_ui_end();
+}
+
+void view_library_settings_init (menu_t *menu) {
+    if (selected < 0 || selected >= ENTRY_COUNT) {
+        selected = 0;
+    }
+}
+
+void view_library_settings_display (menu_t *menu, surface_t *display) {
+    process(menu);
+    draw(menu, display);
+}
