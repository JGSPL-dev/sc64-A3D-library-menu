+// ---------------------------------------------------------------------------
+// Cartridge row
+
+// Cartridge and disk art is pre-rendered at its exact on-screen size (tools/bake_sprites.py),
+// fully opaque, and copied 1:1 at whole-pixel positions: no scaling, filtering or alpha edges.
+static void copy_sprite (sprite_t *s, int x, int y) {
+    rdpq_set_mode_copy(false);
+    rdpq_sprite_blit(s, x, y, NULL);
+}
+
+static void draw_label (const lib_tile_t *t, int wx, int wy, int ww, int wh, bool selected) {
+    if (t->kind == LIB_TILE_ROM && t->label) {
+        blit_surface(t->label, wx, wy, (float)ww / (float)LABEL_WIDTH, (float)wh / (float)LABEL_HEIGHT);
+    } else if (t->kind == LIB_TILE_ROM && t->label_pending) {
+        fill(wx, wy, wx + ww, wy + wh, COLOR_LABEL_LOADING);
+    }
+    if ((t->kind == LIB_TILE_FOLDER || t->kind == LIB_TILE_DISK_FOLDER) && t->code) {
+        text(FNT_LIB_SANS, STL_DEFAULT, wx, wy + wh / 2 + 7, ww, ALIGN_CENTER, t->code);
+    }
+}
+
+static void draw_tile (const lib_tile_t *t, float x_design, bool selected) {
+    float w = selected ? SEL_W : SMALL_W;
+    float h = selected ? SEL_H : SMALL_H;
+    float top = selected ? ROW_TOP : ROW_TOP + (SEL_H - SMALL_H) / 2;
+
+    int x0 = (int)floorf(DX(x_design) + 0.5f), y0 = (int)floorf(DY(top) + 0.5f);
+    int x1 = (int)floorf(DX(x_design + w) + 0.5f), y1 = (int)floorf(DY(top + h) + 0.5f);
+
+    if (t->kind == LIB_TILE_EMPTY) {
+        rounded(x0, y0, x1, y1, 7, selected ? COLOR_WHITE : COLOR_TILE);
+        rounded(x0 + 2, y0 + 2, x1 - 2, y1 - 2, 6, COLOR_BG);
+        return;
+    }
+
+    if (selected) {
+        rounded(x0, y0, x1, y1, 8, COLOR_PURE_WHITE);
+        rounded(x0 + 3, y0 + 4, x1 - 3, y1 - 4, 6, COLOR_BG);
+        rounded(x0 + 5, y0 + 6, x1 - 5, y1 - 6, 5, COLOR_PURE_WHITE);
+    } else {
+        rounded(x0, y0, x1, y1, 7, COLOR_TILE);
+    }
+
+    int cx = (x0 + x1) / 2, cy = (y0 + y1) / 2;
+    bool disk = (t->kind == LIB_TILE_DISK || t->kind == LIB_TILE_DISK_FOLDER);
+    if (disk) {
+        int sw = selected ? DISK_SEL_W : DISK_SMALL_W, sh = selected ? DISK_SEL_H : DISK_SMALL_H;
+        int x = cx - sw / 2, y = cy - sh / 2;
+        copy_sprite(selected ? spr_disk_sel : spr_disk_small, x, y);
+        if (selected) draw_label(t, x + DISK_SEL_WIN_X, y + DISK_SEL_WIN_Y, DISK_SEL_WIN_W, DISK_SEL_WIN_H, true);
+        else draw_label(t, x + DISK_SMALL_WIN_X, y + DISK_SMALL_WIN_Y, DISK_SMALL_WIN_W, DISK_SMALL_WIN_H, false);
+    } else {
+        int sw = selected ? CART_SEL_W : CART_SMALL_W, sh = selected ? CART_SEL_H : CART_SMALL_H;
+        int x = cx - sw / 2, y = cy - sh / 2;
+        copy_sprite(selected ? spr_cart_sel : spr_cart_small, x, y);
+        if (selected) draw_label(t, x + CART_SEL_WIN_X, y + CART_SEL_WIN_Y, CART_SEL_WIN_W, CART_SEL_WIN_H, true);
+        else draw_label(t, x + CART_SMALL_WIN_X, y + CART_SMALL_WIN_Y, CART_SMALL_WIN_W, CART_SMALL_WIN_H, false);
+    }
+}
+
+void library_ui_row (const lib_tile_t *tiles, int count, int selected, bool dimmed, char marker) {
+    if (count <= 0) {
+        return;
+    }
+
+    for (int i = 0; i < count; i++) {
+        float x;
+        if (i == selected) {
+            x = LIB_COLUMN_X;
+        } else if (i < selected) {
+            x = LIB_COLUMN_X - (selected - i) * (SMALL_W + ROW_GAP);
+        } else {
+            x = LIB_COLUMN_X + SEL_W + ROW_GAP + (i - selected - 1) * (SMALL_W + ROW_GAP);
+        }
+        float w = (i == selected) ? SEL_W : SMALL_W;
+        if (x + w < 0 || x > 1280) {
+            continue;
+        }
+
+        draw_tile(&tiles[i], x, i == selected);
+
+        if (i != selected && tiles[i].caption) {
+            char caption[64];
+            int n = 0;
+            for (const char *p = tiles[i].caption; *p && n < (int)sizeof(caption) - 1; p++) {
+                caption[n++] = toupper((unsigned char)*p);
+            }
+            caption[n] = 0;
+            float cap_top = ROW_TOP + (SEL_H - SMALL_H) / 2 + SMALL_H;
+            text(FNT_LIB_MONO, STL_GRAY, DX(x - 6), DY(cap_top + 28), DX(SMALL_W + 12), ALIGN_CENTER, caption);
+        }
+    }
+
+    if (marker) {
+        char m[2] = { marker, 0 };
+        text(FNT_LIB_SANS, STL_DEFAULT, DX(LIB_COLUMN_X + 2), DY(ROW_TOP - 10), 0, ALIGN_LEFT, m);
+    }
+
+    if (dimmed) {
+        dim_area(0, DY(ROW_TOP - 40), 640, DY(ROW_TOP + SEL_H + 50));
+    }
+}
