+/**
+ * @file library_config.c
+ * @brief Library options stored in /menu/library.ini.
+ * @ingroup menu
+ */
+
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+
+#include "library_config.h"
+#include "ini_parser.h"
+#include "path.h"
+
+#define DEFAULT_ORDER   "US, EU, JP, N64 DD, Hacks"
+#define DEFAULT_HIDE    "cpak_saves"
+
+static char *ini_path = NULL;
+static char *order = NULL;
+static char *hide = NULL;
+
+static void set_str (char **dst, const char *src) {
+    free(*dst);
+    *dst = strdup(src ? src : "");
+}
+
+void library_config_init (const char *storage_prefix) {
+    path_t *p = path_init(storage_prefix, "/menu");
+    path_push(p, "library.ini");
+    set_str(&ini_path, path_get(p));
+    path_free(p);
+
+    set_str(&order, DEFAULT_ORDER);
+    set_str(&hide, DEFAULT_HIDE);
+
+    ini_t *ini = ini_try_load(ini_path);
+    if (ini) {
+        set_str(&order, ini_get_string(ini, "library", "order", DEFAULT_ORDER));
+        set_str(&hide, ini_get_string(ini, "library", "hide", DEFAULT_HIDE));
+        ini_free(ini);
+    }
+}
+
+const char *library_config_order (void) {
+    return order ? order : DEFAULT_ORDER;
+}
+
+const char *library_config_hide (void) {
+    return hide ? hide : DEFAULT_HIDE;
+}
+
+void library_config_set_order (const char *new_order) {
+    set_str(&order, new_order);
+    if (!ini_path) {
+        return;
+    }
+    ini_t *ini = ini_try_load(ini_path);
+    if (!ini) {
+        ini = ini_create();
+    }
+    ini_set_string(ini, "library", "order", order);
+    ini_set_string(ini, "library", "hide", library_config_hide());
+    ini_save(ini, ini_path);
+    ini_free(ini);
+}
+
+int library_list_index (const char *list, const char *name) {
+    const char *p = list;
+    size_t len = strlen(name);
+    int idx = 0;
+    while (p && *p) {
+        while (*p == ' ' || *p == ',') p++;
+        if (!*p) break;
+        const char *end = strchr(p, ',');
+        size_t n = end ? (size_t)(end - p) : strlen(p);
+        while (n > 0 && p[n - 1] == ' ') n--;
+        if (n == len && strncasecmp(p, name, n) == 0) {
+            return idx;
+        }
+        idx++;
+        p = end ? end + 1 : NULL;
+    }
+    return -1;
+}
